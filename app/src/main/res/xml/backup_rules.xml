<?xml version="1.0" encoding="utf-8"?>
<!--
   Basecamp #9959340828 (2026-06-03): exclude auth/session SharedPreferences from
   Android auto-backup. With the previous empty rules + allowBackup="true", a
   reinstall auto-restored bid_swipe_App.xml (which holds the auth `token`). On
   first open the restored-but-stale token made SplashActivity route to the
   authenticated Dashboard/Home instead of Login: Home then requested runtime
   permissions and the user was stuck in a broken half-authenticated state
   (token invalid server-side) until they closed and reopened the app. Excluding
   these prefs makes a fresh install a genuine clean slate -> Splash sees no
   token -> routes to Login as intended.
   Applies to API <= 30 (fullBackupContent).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="bid_swipe_App.xml"/>
    <exclude domain="sharedpref" path="bid_swipe_remember.xml"/>
</full-backup-content>
