<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_back"
    android:backgroundTint="@color/surface"
    android:padding="@dimen/margin"
    tools:context=".ui.agoraStream.ProductsForLiveShowFragment">

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title"
            style="@style/TitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_next_product_for_auction" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.7"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@color/tertiary" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        style="@style/inputBoxStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeWidth="2dp"
        app:endIconMode="custom"
        app:endIconTint="@color/scrim"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4"
        app:startIconDrawable="@drawable/search">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/search"
            style="@style/inputTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_products"
            android:inputType="textEmailAddress" />

    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/chipGroupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/half_margin"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/searchLayout">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <ViewSwitcher
        android:id="@+id/switcher"
        android:measureAllChildren="false"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toTopOf="@id/addBtn"
        app:layout_constraintTop_toBottomOf="@+id/chipGroupScroll"
        android:layout_height="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingVertical="@dimen/half_margin">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="510"
                tools:listitem="@layout/product_selection_item" />

            <io.bidswipe.app.ui.custom.NoDataView
                android:id="@+id/noDataView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupScroll"
                app:title_text="No Products Found!" />

            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/bottomLoader"
                style="@style/appLoader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recycler" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingVertical="@dimen/margin">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/surprise_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="510"
                tools:listitem="@layout/product_selection_item" />

            <io.bidswipe.app.ui.custom.NoDataView
                android:id="@+id/surpriseNoDataView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroupScroll"
                app:title_text="No Products Found!" />

            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/surpriseBottomLoader"
                style="@style/appLoader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recycler" />

        </LinearLayout>

    </ViewSwitcher>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addBtn"
        style="@style/appBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin"
        android:text="Add Product"
        app:layout_constraintBottom_toBottomOf="parent" />

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:showBack="false"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>