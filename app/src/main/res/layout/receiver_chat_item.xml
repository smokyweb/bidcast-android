<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:animateLayoutChanges="true">

    <com.sinaseyfi.advancedcardview.AdvancedCardView
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="64dp"
        android:animateLayoutChanges="true"
        app:background_Color="@color/background"
        app:background_Type="fill"
        app:cornerRadius="12dp"
        app:cornerRadius_BottomLeft="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/reply_view"
                layout="@layout/item_reply_view" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/image_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/image"
                    android:layout_width="180dp"
                    android:layout_height="220dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/user_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:riv_corner_radius="10dp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_read"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_check_white_24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/image"
                    app:layout_constraintEnd_toEndOf="@+id/image"
                    app:tint="@color/background" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/chat_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/message"
                    style="@style/BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/toast_message"
                    android:textColor="@color/onBackground" />

            </LinearLayout>

        </LinearLayout>

    </com.sinaseyfi.advancedcardview.AdvancedCardView>

    <TextView
        android:id="@+id/msg_time"
        style="@style/LabelMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/card"
        android:layout_alignParentStart="true"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:text="11:32 am"
        android:textColor="@color/tertiary"
        android:textStyle="bold" />

</RelativeLayout>