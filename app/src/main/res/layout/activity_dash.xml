<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id = "@+id/drawer"
    android:layout_width = "match_parent"
    android:layout_height = "match_parent"
    tools:context = ".ui.dashboard.DashActivity"
    tools:openDrawer = "end" >

    <include
        android:id = "@+id/content_dash"
        layout = "@layout/dash_content" />

    <com.google.android.material.navigation.NavigationView
        android:id = "@+id/side_menu"
        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        style="@style/navStyle"
        android:layout_marginEnd="-65dp"
        android:layout_marginRight="-65dp"
        android:layout_gravity = "end" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <io.bidswipe.app.ui.custom.Header
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerTitle="Seller Tools"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/menu_recycler"
                android:layout_width="match_parent"
                android:background="@color/surface"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/half_margin"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="8"
                tools:listitem="@layout/seller_tools_item" />

        </LinearLayout>

        <io.bidswipe.app.ui.custom.LoaderView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/loader"
            android:visibility="gone"/>


    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>