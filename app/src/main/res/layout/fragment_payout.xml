<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:numberkeyboard="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.sellerHub.PayoutFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerMode="BACK_BUTTON_TITLE_ACTION"
        app:headerTitle="Payout"
        app:layout_constraintTop_toTopOf="parent"
        app:showBackButton="true"
        app:showSecondaryIcon="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/amountCard"
            style="@style/cardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding"
            android:layout_marginTop="16dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/wallet_amount"
                    style="@style/TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrency"
                        style="@style/TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="$"
                        android:textColor="@color/onSurfaceVariant"
                        android:textSize="32sp" />

                    <EditText
                        android:id="@+id/amount"
                        style="@style/TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/transparent"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="0.00"
                        android:textSize="48sp" />
                </LinearLayout>

                <TextView
                    style="@style/BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Minimum payout $10, maximum $500"
                    android:textColor="@color/onSurfaceVariant" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.davidmiguel.numberkeyboard.NumberKeyboard
            android:id="@+id/numberKeyboard"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginHorizontal="@dimen/padding"
            app:numberkeyboard_keyPadding="18dp"
            app:numberkeyboard_leftAuxBtnBackground="@drawable/card_16"
            app:numberkeyboard_leftAuxBtnIcon="@drawable/ic_dot"
            app:numberkeyboard_numberKeyBackground="@drawable/card_16"
            app:numberkeyboard_rightAuxBtnBackground="@drawable/card_16"
            app:numberkeyboard_rightAuxBtnIcon="@drawable/ic_num_back"
            numberkeyboard:numberkeyboard_keyboardType="custom"
            numberkeyboard:numberkeyboard_numberKeyTypeface="@font/poppins_bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/payout"
            style="@style/appBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin"
            android:text="Payout" />
    </LinearLayout>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>