<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.scheduleShow.SelectShowTimeFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerMode="BACK_BUTTON_TITLE_ACTION"
        app:headerTitle="Select Show Time"
        app:layout_constraintTop_toTopOf="parent"
        app:primaryIconDrawable="@drawable/close_ic"
        app:secondaryIconDrawable="@drawable/search"
        app:showBackButton="true"
        app:showPrimaryIcon="false"
        app:showSecondaryIcon="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/continueBtn"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_margin="@dimen/margin"
                style="@style/cardStyle"
                android:layout_height="wrap_content">

                <com.applandeo.materialcalendarview.CalendarView
                    android:id="@+id/calenderView"
                    style="@style/calendarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:text="@string/select_time" />


            <com.google.android.material.textfield.TextInputLayout
                style="@style/inputBoxStyle"
                android:id="@+id/time_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginBottom="@dimen/half_margin">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/time"
                    style="@style/inputTextStyle"
                    android:focusable="false"
                    android:editable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_time" />

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                style="@style/TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:drawablePadding="@dimen/half_margin"
                android:text="@string/why_scedule_in_advance"
                app:drawableStartCompat="@drawable/ic_bulb"
                app:drawableTint="@color/warningClr" />

            <TextView
                style="@style/BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="@dimen/margin"
                android:drawablePadding="@dimen/half_margin"
                android:text="@string/more_potential_buyers_can_plan_to_attend"
                app:drawableStartCompat="@drawable/ic_tick"
                app:drawableTint="@color/success" />

            <TextView
                style="@style/BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/margin"
                android:layout_marginStart="32dp"
                android:drawablePadding="@dimen/half_margin"
                android:text="@string/better_promotion_opportunities"
                app:drawableStartCompat="@drawable/ic_tick"
                app:drawableTint="@color/success" />

            <TextView
                style="@style/BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="@dimen/margin"
                android:drawablePadding="@dimen/half_margin"
                android:text="@string/time_to_prepare_your_items_properly"
                app:drawableStartCompat="@drawable/ic_tick"
                app:drawableTint="@color/success" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueBtn"
        style="@style/appBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:paddingHorizontal="@dimen/margin"
        android:text="@string/continue_to_next_step"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>