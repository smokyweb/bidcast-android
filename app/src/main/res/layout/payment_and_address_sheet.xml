<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_back">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/half_margin"
        android:orientation="vertical">

        <View
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginVertical="@dimen/half_margin"
            android:background="@drawable/card_16"
            android:backgroundTint="@color/outlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/half_margin"
            android:layout_marginHorizontal="@dimen/half_margin"
            android:gravity="center_vertical"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TitleLarge"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/add_payment_method_and_address" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="@dimen/half_margin"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_close"
                app:tint="@color/onSurface"/>

        </LinearLayout>


        <include
            android:id="@+id/paymentCard"
            layout="@layout/payment_card_item" />

        <include
            android:id="@+id/addressItem"
            layout="@layout/shipping_address_item" />


    </LinearLayout>

</ScrollView>