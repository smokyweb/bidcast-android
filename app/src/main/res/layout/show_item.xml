<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/cardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/half_margin"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/half_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_card"
            style="@style/cardStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="@color/outlineVariant"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                android:tint="@color/surface" />

            <TextView
                android:id="@+id/step"
                style="@style/BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/onSecondary"
                android:background="@color/primary"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/half_margin"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedule_your_first_show" />

            <TextView
                android:id="@+id/sub_title"
                style="@style/BodySmall"
                android:textColor="@color/onSurfaceVariant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pick_a_date_and_time_for_your_live_show" />

        </LinearLayout>

    </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/set_schedule"
            style="@style/appBtn"
            android:layout_gravity="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/padding"
            android:paddingVertical="4dp"
            android:text="@string/_continue"
            android:textAppearance="@style/TitleMedium"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>