<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_8"
        android:gravity="center_vertical"
        android:layout_margin="@dimen/half_margin"
        android:paddingStart="@dimen/half_margin"
        android:paddingTop="@dimen/padding"
        android:paddingEnd="@dimen/half_margin"
        android:paddingBottom="@dimen/padding">

        <com.google.android.material.card.MaterialCardView
            style="@style/cardStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardElevation="0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/headingImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/avatar"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/heading"
            style="@style/TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/half_margin"
            android:text="Selected Categories"
            android:textSize="16sp"/>

        </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/cardStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/transparent"
        app:cardElevation="0dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/half_margin"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/heading"
        app:spanCount="2"
        tools:itemCount="6"
        tools:layout_editor_absoluteX="8dp"
        tools:listitem="@layout/sub_category_item" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>