<?xml version="1.0" encoding="utf-8"?>
<!-- Basecamp #9929090875 (Trey 2026-05-26): unified search results now rendered
     in a real RecyclerView (unifiedResultsRecycler) below the shows grid.
     The old unifiedSearchSummary count-only TextView is removed. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.SearchShowFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        style="@style/inputBoxStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginBottom="@dimen/margin"
        app:boxStrokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:startIconDrawable="@drawable/search"
        app:startIconTint="@color/outlineVariant">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/search"
            style="@style/inputTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/what_are_you_looking_for"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        app:alignContent="space_around"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchLayout"
        app:singleLine="true"
        app:singleSelection="true" />

    <LinearLayout
        android:id="@+id/heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginBottom="@dimen/margin"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroup">

        <TextView
            android:id="@+id/live"
            style="@style/TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/live_now" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/half_margin"
            android:layout_marginVertical="4dp" />

        <TextView
            android:id="@+id/popular"
            style="@style/TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/popular" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/half_margin"
            android:layout_marginVertical="4dp" />

        <TextView
            android:id="@+id/comingSoon"
            style="@style/TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/comming_soon" />

    </LinearLayout>

    <!-- Shows grid — occupies the top half of the results area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/half_margin"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/unifiedSectionLabel"
        app:layout_constraintTop_toBottomOf="@id/heading"
        app:spanCount="2"
        tools:itemCount="4"
        tools:listitem="@layout/home_item" />

    <!-- Basecamp #9929090875 (Trey 2026-05-26): section header for user+product results.
         Hidden when the query is blank or unified search returns nothing.
         FIX (deep-diag 2026-05-26): added constraintTop_toBottomOf=recycler so that
         ConstraintLayout can anchor the label below the shows grid and form a proper
         vertical chain. Without this top constraint the label floated to y=0, placing
         the unified results RecyclerView behind the header (invisible). -->
    <TextView
        android:id="@+id/unifiedSectionLabel"
        style="@style/TitleSemiBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin"
        android:paddingVertical="6dp"
        android:text="Users &amp; Products"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/unifiedResultsRecycler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recycler" />

    <!-- Basecamp #9929090875: actual user + product rows from /api/v1/search.
         FIX (deep-diag 2026-05-26): three changes needed to make rows actually visible:
         1. height: 0dp → wrap_content. The 0dp match_constraint resolved to 0 because
            the vertical chain was underconstrained (unifiedSectionLabel had no top).
         2. constraintHeight_max=220dp caps the section so it doesn't push shows off
            screen; RecyclerView scrolls internally for more items.
         3. constraintVertical_bias=1.0 bottom-aligns the section to parent.bottom,
            which pins the entire chain upward and resolves all positions deterministically.
            Without bias the view floats center-between-constraints (wrong position). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unifiedResultsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="220dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unifiedSectionLabel"
        app:layout_constraintVertical_bias="1.0"
        tools:itemCount="3"
        tools:listitem="@layout/search_result_item" />

    <io.bidswipe.app.ui.custom.NoDataView
        android:id="@+id/noData"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heading"
        app:title_text="No Shows Found" />

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
