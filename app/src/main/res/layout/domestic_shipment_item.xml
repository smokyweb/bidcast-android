<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android = "http://schemas.android.com/apk/res/android"
	style = "@style/shadowStyle"
	android:layout_width = "match_parent"
	android:layout_height = "wrap_content"
	android:layout_marginHorizontal="4dp"
	android:layout_marginVertical="@dimen/half_margin"
	android:background = "@drawable/card_8"
	android:gravity = "center_vertical"
	android:orientation = "horizontal"
	android:padding = "12dp" >

    <androidx.appcompat.widget.AppCompatImageView
	    android:id = "@+id/image"
	    android:layout_width = "48dp"
	    android:layout_height = "48dp"
	    android:layout_marginEnd = "@dimen/half_margin"
	    android:layout_gravity="top"
        android:background="@drawable/card_8"
        android:backgroundTint="@color/primaryContainer"
	    android:src = "@drawable/usps_logo" />

        <LinearLayout
	        android:layout_width = "0dp"
	        android:layout_height = "wrap_content"
	        android:layout_weight = "1"
	        android:orientation = "vertical" >

            <TextView
	            android:id = "@+id/title"
	            style = "@style/TitleSmall"
	            android:layout_width = "match_parent"
	            android:layout_height = "wrap_content"
	            android:text = "USPS First-Class Mail Letter" />

            <TextView
	            android:id = "@+id/subTitle"
	            style = "@style/BodySmall"
	            android:layout_width = "match_parent"
	            android:layout_height = "wrap_content"
	            android:alpha = "0.8"
	            android:text = "For shipments under $20 that weigh 3 oz or less in Trading Card Games, Sports Cards, or Stickers categories. View the full criteria here." />

        </LinearLayout >

        <com.google.android.material.radiobutton.MaterialRadioButton
	        style="@style/appRadio"
	        android:id = "@+id/check"
	        android:layout_width = "wrap_content"
			android:minWidth="0dp"
			android:minHeight="0dp"
            android:includeFontPadding="false"
            android:layoutDirection="rtl"
	        android:layout_height = "wrap_content" />

    </LinearLayout >
