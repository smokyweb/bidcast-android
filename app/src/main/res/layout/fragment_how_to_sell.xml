<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.dashboard.tutorials.HowToSellFragment">

    <io.bidcast.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerMode="BACK_BUTTON_TITLE_ACTION"
        app:layout_constraintTop_toTopOf="parent"
        app:primaryIconDrawable="@drawable/close_ic"
        app:secondaryIconDrawable="@drawable/search"
        app:showBackButton="true"
        app:showPrimaryIcon="false"
        app:showSecondaryIcon="false"
        app:headerTitle="How to Sell"
        />

    <LinearLayout
        android:id="@+id/stepProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/track"
            android:layout_width="match_parent"
            android:progress="15"
            android:progressTint="@color/primary"
            android:layout_height="wrap_content"/>

        <TextView
            style="@style/TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step 1 of 7"
            android:layout_margin="@dimen/margin"
            android:textColor="@color/primary"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/stepProgress"
        app:layout_constraintBottom_toTopOf="@id/buttonLayout"

        >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/half_margin"
        android:orientation="vertical">

    <TextView
        style="@style/HeadlineMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/half_margin"
        android:text="Become a Bidcast Seller" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginVertical="@dimen/margin">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/tutorial"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/half_margin"
            android:layout_gravity="center"
            android:text="Start your selling journey on Bidcast! Learn how to list products, manage your store, and connect with buyers." />


        <TextView
            style="@style/TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"
            android:layout_marginStart="@dimen/margin"
            android:layout_gravity="center"
            android:text="What you'll learn:" />

        <TextView
            style="@style/BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_gravity="center"
            android:drawablePadding="@dimen/half_margin"
            android:drawableStart="@drawable/ic_tick"
            android:text="Creating product listings" />

        <TextView
            style="@style/BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_gravity="center"
            android:drawablePadding="@dimen/half_margin"
            android:drawableStart="@drawable/ic_tick"
            android:text="Setting up your store" />

        <TextView
            style="@style/BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin"
            android:layout_gravity="center"
            android:drawablePadding="@dimen/half_margin"
            android:drawableStart="@drawable/ic_tick"
            android:text="Managing orders &amp; shipping" />



    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decline"
            style="@style/appBtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/margin"
            android:text="Back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accept"
            style="@style/appBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin"
            android:layout_weight="1"
            android:backgroundTint="@color/secondary"
            android:paddingHorizontal="@dimen/margin"
            android:text="Next" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>