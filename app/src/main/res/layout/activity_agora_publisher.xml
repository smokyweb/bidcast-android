<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.agoraStream.AgoraPublisherActivity">

    <FrameLayout
        android:id="@+id/publisherView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/center_gradient">

        <LinearLayout
            android:id="@+id/profileLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_card"
                    style="@style/cardStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/hostImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_image" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/half_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hostName"
                        style="@style/TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/username"
                        android:textColor="@color/surface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/duration"
                        style="@style/BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/show_time_00_00_01"
                        android:textColor="@color/surface" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rehearsalLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/half_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/liveCount"
                    style="@style/appTonalBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="@dimen/half_margin"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="0"
                    android:textSize="12sp"
                    app:backgroundTint="@color/black25"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_broadcast"
                    app:iconPadding="6dp"
                    android:textColor="@color/onPrimary"
                    app:iconSize="20sp"
                    app:iconTint="@null" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rehearsal"
                    style="@style/cardStyle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom"
                    app:cardBackgroundColor="@color/black25"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/cutButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:src="@drawable/ic_down"
                        android:tint="@color/surface" />

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/show_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/half_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profileLayout"
            android:background="@drawable/card_8"
            android:padding="@dimen/half_margin"
            android:backgroundTint="@color/surfaceVariant"
            style="@style/LabelLarge"
            android:elevation="4dp"
            android:text="@string/show_nnotes"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profileLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/view2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:layout_constraintBottom_toTopOf="@id/controls" />

                <LinearLayout
                    android:id="@+id/controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_gravity="bottom"
                                android:nestedScrollingEnabled="true"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                app:layout_constraintBottom_toTopOf="@id/product"
                                app:layout_constraintDimensionRatio="1:1"
                                app:reverseLayout="false"
                                app:stackFromEnd="true"
                                tools:itemCount="10"
                                tools:listitem="@layout/live_comment_item" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/message"
                                style="@style/inputBoxStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin"
                                android:layout_marginBottom="@dimen/margin"
                                app:boxBackgroundColor="@color/transparent"
                                app:endIconDrawable="@drawable/ic_forward"
                                app:endIconMode="custom"
                                app:boxStrokeColor="@color/input_box_stroke_color_surface"
                                app:layout_constraintBottom_toTopOf="@+id/product">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/message_text"
                                    style="@style/inputTextStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/say_something"
                                    android:imeOptions="actionSend"
                                    android:inputType="text"
                                    android:minHeight="0dp"
                                    android:paddingVertical="8dp"
                                    android:textColor="@color/surface"
                                    android:textColorHint="@color/surfaceVariant" />

                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/menuLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toTopOf="@+id/message"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/rehearsalLayout">

                            <LinearLayout
                                android:id="@+id/more"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_more"
                                    android:tint="@color/surface" />

                                <TextView
                                    style="@style/LabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="More"
                                    android:textColor="@color/surface" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/promote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_promote"
                                    android:tint="@color/surface" />

                                <TextView
                                    style="@style/LabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Promote"
                                    android:textColor="@color/surface" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/clip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_clip_new"
                                    android:tint="@color/surface" />

                                <TextView
                                    style="@style/LabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Clip"
                                    android:textColor="@color/surface" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/share"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/share"
                                    android:tint="@color/surface" />

                                <TextView
                                    style="@style/LabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Share"
                                    android:textColor="@color/surface" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/camera_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/camera_reverse"
                                    android:tint="@color/surface" />

                                <TextView
                                    style="@style/LabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Camera"
                                    android:textColor="@color/surface" />

                            </LinearLayout>

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/half_margin">

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/cardStyle"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    app:cardBackgroundColor="@color/surface"
                                    app:cardElevation="0dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/cardStyle"
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    app:cardBackgroundColor="@color/surface"
                                    app:cardElevation="2dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/product_img" />

                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/shop"
                                    style="@style/cardStyle"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginTop="8dp"
                                    app:cardBackgroundColor="@color/surface"
                                    app:cardElevation="3dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/product_image_shop"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/placeholder_square" />
                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    style="@style/LabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shop"
                                    android:textColor="@color/surface"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/shop" />

                                <TextView
                                    android:id="@+id/count_badge"
                                    style="@style/LabelMedium"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:background="@drawable/card_16"
                                    android:backgroundTint="@color/primary"
                                    android:elevation="4dp"
                                    android:gravity="center"
                                    android:text="1"
                                    android:textColor="@color/onError"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/poll"
                        style="@style/cardStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin"
                        android:layout_marginTop="@dimen/margin"
                        android:backgroundTint="@color/black25"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/half_margin">

                            <!-- Poll Icon -->
                            <com.google.android.material.card.MaterialCardView
                                style="@style/cardStyle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:backgroundTint="@color/primaryContainer"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_poll"
                                    android:tint="@color/primary" />

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Poll Info -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/pollQuestionPreview"
                                    style="@style/TitleMedium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="What do you prefer?"
                                    android:textColor="@color/surface" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/pollTimerPreview"
                                        style="@style/BodySmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="2:30 remaining"
                                        android:textColor="@color/error"
                                        android:textSize="12sp" />

                                    <View
                                        android:layout_width="4dp"
                                        android:layout_height="4dp"
                                        android:layout_marginHorizontal="8dp"
                                        android:alpha="0.5"
                                        android:background="@drawable/card_16"
                                        android:backgroundTint="@color/surface" />

                                    <TextView
                                        android:id="@+id/pollTotalVotesPreview"
                                        style="@style/BodySmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:alpha="0.7"
                                        android:text="125 votes"
                                        android:textColor="@color/surface"
                                        android:textSize="12sp" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Arrow Icon -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="@dimen/half_margin"
                                android:alpha="0.7"
                                android:src="@drawable/ic_forward"
                                android:tint="@color/surface" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin"
                        android:layout_marginTop="@dimen/margin"
                        android:backgroundTint="@color/transparent"
                        android:visibility="gone"
                        app:layout_constraintBottom_toTopOf="@id/bidLayout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:id="@+id/product_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/winningLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginStart="@dimen/half_margin"
                                android:paddingVertical="4dp"
                                android:visibility="gone">

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/cardStyle"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@color/transparent"
                                    app:cardCornerRadius="100dp"
                                    app:cardElevation="0dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/userImage"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/placeholder_user" />

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:id="@+id/winning"
                                    style="@style/TitleSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="@dimen/half_margin"
                                    android:text="Jack lee is winning!"
                                    android:textColor="@color/onPrimary" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="@dimen/half_margin">

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/cardStyle"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="0dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/productImage"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/shoe" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="@dimen/half_margin"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/productName"
                                        style="@style/TitleLarge"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="White Sneakers"
                                        android:textColor="@color/surface" />

                                    <TextView
                                        android:id="@+id/product_category"
                                        style="@style/BodySmall"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Sports &amp; Lifestyle"
                                        android:textColor="@color/surface" />

                                    <TextView
                                        android:id="@+id/quantity"
                                        style="@style/BodySmall"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Quantity: 1"
                                        android:textColor="@color/surface" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginEnd="@dimen/half_margin"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/bidPrice"
                                        style="@style/TitleLarge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="$23.00"
                                        android:textColor="@color/surface" />

                                    <TextView
                                        android:id="@+id/bid_time"
                                        style="@style/BodySmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:drawableStart="@drawable/skull"
                                        android:drawablePadding="4dp"
                                        android:text="00:00:00"
                                        android:visibility="gone"
                                        android:textColor="@color/error" />

                                    <TextView
                                        android:id="@+id/status"
                                        style="@style/BodySmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Sold"
                                        android:visibility="visible"
                                        android:textColor="@color/error" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/sold_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/half_margin"
                            android:layout_marginHorizontal="@dimen/half_margin"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/soldOutText"
                                style="@style/TitleLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sold Out!"
                                android:textColor="@color/surface" />

                            <TextView
                                style="@style/BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Please select for next product" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startBtn"
                        style="@style/appBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin"
                        android:layout_marginBottom="@dimen/margin"
                        android:text="@string/start_now"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <LinearLayout
                        android:id="@+id/runNextLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2"
                        android:visibility="gone"
                        android:layout_marginHorizontal="@dimen/margin"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            style="@style/appTonalBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin"
                            android:layout_marginEnd="@dimen/half_margin"
                            android:enabled="false"
                            android:layout_weight="1"
                            android:text="5 Bids"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/runNext"
                            style="@style/appBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin"
                            android:layout_marginStart="@dimen/half_margin"
                            android:layout_weight="1"
                            android:text="Run Next"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lucky_wheel_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/cardStyle"
        android:padding="2dp"
        android:visibility="gone"
        app:cardCornerRadius="1000dp"
        android:elevation="4dp"
        android:layout_marginTop="64dp"
        android:layout_marginHorizontal="32dp"
        app:cardBackgroundColor="@color/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1">

        <com.caneryilmaz.apps.luckywheel.ui.LuckyWheelView
            android:id="@+id/lucky_wheel"
            android:layout_width="match_parent"
            app:arrowPosition="CENTER"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>