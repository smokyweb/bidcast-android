<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android = "http://schemas.android.com/apk/res/android"
	xmlns:app = "http://schemas.android.com/apk/res-auto"
	xmlns:tools = "http://schemas.android.com/tools"
	android:id = "@+id/main"
	android:layout_width = "match_parent"
	android:layout_height = "match_parent"
	tools:context = ".ui.agoraStream.AgoraPublisherActivity" >

	<FrameLayout
		android:id = "@+id/publisherView"
		android:layout_width = "match_parent"
		android:layout_height = "match_parent"/>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id = "@+id/controls_view"
		android:layout_width = "match_parent"
		android:layout_height = "match_parent"
		android:background = "@drawable/center_gradient" >

		<LinearLayout
			android:id = "@+id/profileLayout"
			android:layout_width = "match_parent"
			android:layout_height = "wrap_content"
			android:baselineAligned = "false"
			android:gravity = "center_vertical"
			android:paddingStart = "@dimen/padding"
			android:paddingEnd = "0dp"
			app:layout_constraintTop_toTopOf = "parent" >

			<LinearLayout
				android:layout_width = "0dp"
				android:layout_height = "wrap_content"
				android:layout_weight = "1"
				app:layout_constraintStart_toStartOf = "parent"
				app:layout_constraintTop_toTopOf = "parent" >

				<com.google.android.material.card.MaterialCardView
					android:id = "@+id/icon_card"
					style = "@style/cardStyle"
					android:layout_width = "48dp"
					android:layout_height = "48dp"
					app:cardCornerRadius = "100dp"
					app:cardElevation = "0dp" >

					<androidx.appcompat.widget.AppCompatImageView
						android:id = "@+id/hostImage"
						android:layout_width = "match_parent"
						android:layout_height = "match_parent"
						android:scaleType = "centerCrop"
						android:src = "@drawable/user_image" />

				</com.google.android.material.card.MaterialCardView >

				<LinearLayout
					android:layout_width = "0dp"
					android:layout_height = "wrap_content"
					android:layout_marginHorizontal = "@dimen/half_margin"
					android:layout_weight = "1"
					android:orientation = "vertical" >

					<TextView
						android:id = "@+id/hostName"
						style = "@style/TitleLarge"
						android:layout_width = "match_parent"
						android:layout_height = "wrap_content"
						android:text = "@string/username"
						android:textColor = "@color/surface"
						android:textSize = "16sp" />

					<TextView
						android:id = "@+id/duration"
						style = "@style/BodySmall"
						android:layout_width = "match_parent"
						android:layout_height = "wrap_content"
						android:text = "@string/show_time_00_00_01"
						android:textColor = "@color/surface" />

				</LinearLayout >

			</LinearLayout >

			<LinearLayout
				android:id = "@+id/rehearsalLayout"
				android:layout_width = "wrap_content"
				android:layout_height = "wrap_content"
				android:layout_marginHorizontal = "@dimen/half_margin"
				android:gravity = "center_vertical"
				android:orientation = "horizontal"
				app:layout_constraintEnd_toEndOf = "parent"
				app:layout_constraintTop_toTopOf = "parent" >

				<com.google.android.material.button.MaterialButton
					android:id = "@+id/liveCount"
					style = "@style/appTonalBtn"
					android:layout_width = "wrap_content"
					android:layout_height = "wrap_content"
					android:layout_marginEnd = "@dimen/half_margin"
					android:minWidth = "45dp"
					android:minHeight = "0dp"
					android:padding = "6dp"
					android:text = "1"
					android:textSize = "14sp" />

				<com.google.android.material.card.MaterialCardView
					android:id = "@+id/rehearsal"
					style = "@style/cardStyle"
					android:layout_width = "40dp"
					android:layout_height = "40dp"
					app:cardCornerRadius = "100dp"
					app:cardElevation = "0dp" >

					<androidx.appcompat.widget.AppCompatImageView
						android:id = "@+id/cutButton"
						android:layout_width = "match_parent"
						android:layout_height = "match_parent"
						android:padding = "12dp"
						android:src = "@drawable/close_ic" />

				</com.google.android.material.card.MaterialCardView >

			</LinearLayout >

		</LinearLayout >

		<ScrollView
			android:layout_width = "match_parent"
			android:layout_height = "0dp"
			android:fillViewport = "true"
			app:layout_constraintBottom_toBottomOf = "parent"
			app:layout_constraintTop_toBottomOf = "@id/profileLayout" >

			<LinearLayout
				android:layout_width = "match_parent"
				android:layout_height = "wrap_content"
				android:orientation = "vertical" >

				<View
					android:id = "@+id/view2"
					android:layout_width = "match_parent"
					android:layout_height = "0dp"
					android:layout_weight = "1"
					app:layout_constraintBottom_toTopOf = "@id/controls" />

				<LinearLayout
					android:id = "@+id/controls"
					android:layout_width = "match_parent"
					android:layout_height = "wrap_content"
					android:orientation = "vertical"
					app:layout_constraintBottom_toBottomOf = "parent"
					app:layout_constraintEnd_toEndOf = "parent"
					app:layout_constraintTop_toBottomOf = "@+id/view2" >

					<LinearLayout
						android:layout_width = "match_parent"
						android:layout_height = "0dp"
						android:layout_weight = "1"
						android:gravity = "bottom"
						android:orientation = "horizontal" >

						<androidx.recyclerview.widget.RecyclerView
							android:id = "@+id/recycler"
							android:layout_width = "0dp"
							android:layout_height = "200dp"
							android:layout_gravity = "bottom"
							android:layout_marginEnd = "32dp"
							android:layout_weight = "1"
							android:nestedScrollingEnabled = "true"
							app:layoutManager = "androidx.recyclerview.widget.LinearLayoutManager"
							app:layout_constraintBottom_toTopOf = "@id/product"
							app:layout_constraintDimensionRatio = "1:1"
							app:reverseLayout = "false"
							app:stackFromEnd = "true"
							tools:itemCount = "10"
							tools:listitem = "@layout/live_comment_item" />

						<LinearLayout
							android:id = "@+id/menuLayout"
							android:layout_width = "wrap_content"
							android:layout_height = "wrap_content"
							android:layout_marginEnd = "@dimen/margin"
							android:gravity = "center_horizontal"
							android:orientation = "vertical"
							app:layout_constraintBottom_toTopOf = "@+id/message"
							app:layout_constraintEnd_toEndOf = "parent"
							app:layout_constraintTop_toBottomOf = "@id/rehearsalLayout" >

							<com.google.android.material.card.MaterialCardView
								android:id = "@+id/more"
								style = "@style/cardStyle"
								android:layout_width = "48dp"
								android:layout_height = "48dp"
								android:layout_marginBottom = "@dimen/margin"
								app:cardCornerRadius = "100dp"
								app:cardElevation = "0dp" >

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width = "match_parent"
									android:layout_height = "match_parent"
									android:padding = "12dp"
									android:src = "@drawable/ic_more"
									android:tint = "@color/scrim" />

							</com.google.android.material.card.MaterialCardView >

							<com.google.android.material.card.MaterialCardView
								android:id = "@+id/promote"
								style = "@style/cardStyle"
								android:layout_width = "48dp"
								android:layout_height = "48dp"
								android:layout_marginBottom = "@dimen/margin"
								app:cardCornerRadius = "100dp"
								app:cardElevation = "0dp" >

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width = "match_parent"
									android:layout_height = "match_parent"
									android:padding = "12dp"
									android:src = "@drawable/ic_promote"
									android:tint = "@color/scrim" />

							</com.google.android.material.card.MaterialCardView >


							<com.google.android.material.card.MaterialCardView
								android:id = "@+id/clip"
								style = "@style/cardStyle"
								android:layout_width = "48dp"
								android:layout_height = "48dp"
								android:layout_marginBottom = "@dimen/margin"
								app:cardCornerRadius = "100dp"
								app:cardElevation = "0dp" >

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width = "match_parent"
									android:layout_height = "match_parent"
									android:padding = "12dp"
									android:src = "@drawable/ic_clip"
									android:tint = "@color/scrim" />

							</com.google.android.material.card.MaterialCardView >


							<com.google.android.material.card.MaterialCardView
								android:id = "@+id/share"
								style = "@style/cardStyle"
								android:layout_width = "48dp"
								android:layout_height = "48dp"
								android:layout_marginBottom = "@dimen/margin"
								app:cardCornerRadius = "100dp"
								app:cardElevation = "0dp" >

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width = "match_parent"
									android:layout_height = "match_parent"
									android:padding = "12dp"
									android:src = "@drawable/share_arrow"
									android:tint = "@color/scrim" />

							</com.google.android.material.card.MaterialCardView >

							<com.google.android.material.card.MaterialCardView
								android:id = "@+id/camera_switch"
								style = "@style/cardStyle"
								android:layout_width = "48dp"
								android:layout_height = "48dp"
								android:layout_marginBottom = "@dimen/margin"
								app:cardCornerRadius = "100dp"
								app:cardElevation = "0dp" >

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width = "match_parent"
									android:layout_height = "match_parent"
									android:padding = "12dp"
									android:src = "@drawable/camera_reverse" />

							</com.google.android.material.card.MaterialCardView >

							<androidx.constraintlayout.widget.ConstraintLayout
								android:layout_width = "wrap_content"
								android:layout_height = "wrap_content" >

								<com.google.android.material.card.MaterialCardView
									android:id = "@+id/shop"
									style = "@style/cardStyle"
									android:layout_width = "48dp"
									android:layout_height = "48dp"
									android:layout_marginBottom = "@dimen/margin"
									app:cardCornerRadius = "100dp"
									app:cardElevation = "0dp"
									app:layout_constraintBottom_toBottomOf = "parent"
									app:layout_constraintEnd_toEndOf = "parent"
									app:layout_constraintStart_toStartOf = "parent"
									app:layout_constraintTop_toTopOf = "parent"
									app:strokeColor = "@color/primary" >

									<androidx.appcompat.widget.AppCompatImageView
										android:layout_width = "match_parent"
										android:layout_height = "match_parent"
										android:padding = "12dp"
										android:src = "@drawable/ic_shop" />

								</com.google.android.material.card.MaterialCardView >

								<TextView
									android:id = "@+id/count_badge"
									style = "@style/LabelMedium"
									android:layout_width = "18dp"
									android:layout_height = "18dp"
									android:background = "@drawable/card_16"
									android:backgroundTint = "@color/primary"
									android:gravity = "center"
									android:text = "1"
									android:textColor = "@color/onError"
									android:visibility = "gone"
									app:layout_constraintEnd_toEndOf = "parent"
									app:layout_constraintTop_toTopOf = "@id/shop" />

							</androidx.constraintlayout.widget.ConstraintLayout >

						</LinearLayout >

					</LinearLayout >

					<com.google.android.material.card.MaterialCardView
						android:id = "@+id/pollCard"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_margin="@dimen/margin">



					</com.google.android.material.card.MaterialCardView>

					<com.google.android.material.card.MaterialCardView
						android:id = "@+id/product"
						android:layout_width = "match_parent"
						android:layout_height = "wrap_content"
						android:layout_marginHorizontal = "@dimen/margin"
						android:layout_marginTop = "@dimen/margin"
						android:backgroundTint = "@color/black25"
						android:visibility = "gone"
						app:layout_constraintBottom_toTopOf = "@id/bidLayout"
						app:layout_constraintStart_toStartOf = "parent"
						app:strokeWidth = "0dp" >

						<LinearLayout
							android:id = "@+id/product_layout"
							android:layout_width = "match_parent"
							android:layout_height = "match_parent"
							android:orientation = "horizontal"
							android:padding = "@dimen/half_margin" >

							<com.google.android.material.card.MaterialCardView
								style = "@style/cardStyle"
								android:layout_width = "80dp"
								android:layout_height = "80dp"
								app:cardCornerRadius = "10dp"
								app:cardElevation = "0dp" >

								<androidx.appcompat.widget.AppCompatImageView
									android:id = "@+id/productImage"
									android:layout_width = "match_parent"
									android:layout_height = "match_parent"
									android:scaleType = "centerCrop"
									android:src = "@drawable/shoe" />

							</com.google.android.material.card.MaterialCardView >

							<LinearLayout
								android:layout_width = "0dp"
								android:layout_height = "match_parent"
								android:layout_marginHorizontal = "@dimen/half_margin"
								android:layout_weight = "1"
								android:gravity = "center_vertical"
								android:orientation = "vertical" >

								<TextView
									android:id = "@+id/productName"
									style = "@style/TitleLarge"
									android:layout_width = "match_parent"
									android:layout_height = "wrap_content"
									android:text = "White Sneakers"
									android:textColor = "@color/surface" />

								<TextView
									android:id = "@+id/product_category"
									style = "@style/BodySmall"
									android:layout_width = "match_parent"
									android:layout_height = "wrap_content"
									android:text = "Sports &amp; Lifestyle"
									android:textColor = "@color/surface" />

								<TextView
									android:id = "@+id/quantity"
									style = "@style/BodySmall"
									android:layout_width = "match_parent"
									android:layout_height = "wrap_content"
									android:text = "Quantity: 1"
									android:textColor = "@color/surface" />

							</LinearLayout >

							<LinearLayout
								android:layout_width = "wrap_content"
								android:layout_height = "wrap_content"
								android:layout_gravity = "center_vertical"
								android:layout_marginEnd = "@dimen/half_margin"
								android:orientation = "vertical" >

								<TextView
									android:id = "@+id/bidPrice"
									style = "@style/TitleLarge"
									android:layout_width = "wrap_content"
									android:layout_height = "wrap_content"
									android:layout_gravity = "center"
									android:text = "$23.00"
									android:textColor = "@color/surface" />

								<TextView
									android:id = "@+id/bid_time"
									style = "@style/BodySmall"
									android:layout_width = "wrap_content"
									android:layout_height = "wrap_content"
									android:layout_gravity = "center"
									android:text = "00:00:00"
									android:textColor = "@color/error" />

							</LinearLayout >

						</LinearLayout >

						<LinearLayout
							android:id = "@+id/sold_layout"
							android:layout_width = "match_parent"
							android:layout_height = "match_parent"
							android:layout_margin = "@dimen/half_margin"
							android:layout_marginHorizontal = "@dimen/half_margin"
							android:layout_weight = "1"
							android:gravity = "center_horizontal"
							android:orientation = "vertical"
							android:visibility = "gone" >

							<TextView
								android:id = "@+id/soldOutText"
								style = "@style/TitleLarge"
								android:layout_width = "wrap_content"
								android:layout_height = "wrap_content"
								android:text = "Sold Out!"
								android:textColor = "@color/surface"/>

							<TextView
								style = "@style/BodySmall"
								android:layout_width = "wrap_content"
								android:layout_height = "wrap_content"
								android:text = "Please select for next product" />

						</LinearLayout >


					</com.google.android.material.card.MaterialCardView >

					<com.google.android.material.textfield.TextInputLayout
						android:id = "@+id/message"
						style = "@style/inputBoxStyle"
						android:layout_width = "match_parent"
						android:layout_height = "wrap_content"
						android:layout_marginHorizontal = "@dimen/margin"
						android:layout_marginVertical = "@dimen/margin"
						app:boxBackgroundColor = "@color/black25"
						app:boxStrokeWidth = "0dp"
						app:endIconDrawable = "@drawable/ic_forward"
						app:endIconMode = "custom"
						app:layout_constraintBottom_toTopOf = "@+id/startBtn" >

						<com.google.android.material.textfield.MaterialAutoCompleteTextView
							android:id = "@+id/text"
							style = "@style/inputTextStyle"
							android:layout_width = "match_parent"
							android:layout_height = "wrap_content"
							android:hint = "@string/say_something"
							android:inputType = "text"
							android:textColor = "@color/surface" />

					</com.google.android.material.textfield.TextInputLayout >

					<com.google.android.material.button.MaterialButton
						android:id = "@+id/startBtn"
						style = "@style/appBtn"
						android:layout_width = "match_parent"
						android:layout_height = "wrap_content"
						android:layout_marginHorizontal = "@dimen/margin"
						android:layout_marginBottom = "@dimen/margin"
						android:text = "@string/start_now"
						app:layout_constraintBottom_toBottomOf = "parent" />

				</LinearLayout >

			</LinearLayout >

		</ScrollView >

	</androidx.constraintlayout.widget.ConstraintLayout >

	<io.bidswipe.app.ui.custom.LoaderView
		android:id="@+id/loader"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout >