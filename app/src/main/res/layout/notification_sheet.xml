<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/top_curve"
    android:backgroundTint="@android:color/white"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingBottom="@dimen/padding">

    <View
        android:id="@+id/topView"
        android:layout_width="64dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:background="@drawable/card_16"
        android:backgroundTint="@color/outlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/closeCard"
        style="@style/cardStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/margin"
        android:layout_marginEnd="@dimen/margin"
        android:backgroundTint="@color/error"
        app:cardCornerRadius="100dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin"
            android:src="@drawable/close_ic"
            app:tint="@color/background" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/userLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topView">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_card"
            style="@style/cardStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/user_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_user" />

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/user_name"
            style="@style/TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin"
            android:text="@string/john_smith" />

    </LinearLayout>


    <TextView
        android:id="@+id/text"
        style="@style/BodyLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:gravity="center"
        android:text="@string/would_you_like_to_notified_when_usrname_goes_live"
        app:layout_constraintTop_toBottomOf="@id/userLayout" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submit"
        style="@style/appBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:text="@string/yes_notify_me"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:strokeWidth="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/noBtn"
        style="@style/appBtnOutline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:layout_marginBottom="16dp"
        android:text="@string/no_thanks"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/submit"
        app:strokeWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>