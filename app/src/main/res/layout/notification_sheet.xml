<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:elevation="4dp"
    android:background="@drawable/top_curve"
    android:backgroundTint="@android:color/white"
    android:orientation="vertical">

    <View
        android:id="@+id/topView"
        android:layout_width="64dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:background="@drawable/card_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="@color/outlineVariant" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/closeCard"
        style="@style/cardStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="100dp"
        android:layout_marginTop="@dimen/margin"
        android:layout_marginEnd="@dimen/margin"
        android:backgroundTint="@color/error"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="0dp">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin"
            app:tint="@color/background"
            android:src="@drawable/close_ic" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/userLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/topView"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_card"
            style="@style/cardStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/user_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/user_image" />

        </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/user_name"
                style="@style/TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="John Smith" />

    </LinearLayout>


    <TextView
        android:id="@+id/text"
        style="@style/BodyLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/userLayout"
        android:text="Would you like to notified when @usrname goes live" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submit"
        style="@style/appBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:text="@string/yes_notify_me"
        app:layout_constraintTop_toBottomOf="@id/text"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/noBtn"
        style="@style/appBtnOutline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:text="@string/no_thanks"
        app:layout_constraintTop_toBottomOf="@id/submit"/>


</androidx.constraintlayout.widget.ConstraintLayout>