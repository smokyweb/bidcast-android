<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.sellerHub.SellerOrderDetailFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Order Detail"
        app:layout_constraintTop_toTopOf="parent"
        app:primaryIconDrawable="@drawable/ic_close"
        app:showBackButton="true" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="@dimen/half_margin"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/buttonLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/margin">

                <LinearLayout
                    android:id="@+id/click"
                    style="@style/shadowStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/product_card"
                        style="@style/cardStyle"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:cardBackgroundColor="@color/tertiaryContainer"
                        app:cardCornerRadius="100dp"
                        app:cardElevation="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/productImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/shoe" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/productName"
                            style="@style/TitleSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Premium Wireless Headphones" />

                        <TextView
                            android:id="@+id/category"
                            style="@style/BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:text="" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.5"
                    android:layout_marginVertical="@dimen/margin" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="@string/order_id" />

                    <TextView
                        android:id="@+id/orderId"
                        style="@style/TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:text="#48643546" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="@string/order_date" />

                    <TextView
                        android:id="@+id/orderDate"
                        style="@style/TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:text="Jan 15, 2025" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="@string/quantity" />

                    <TextView
                        android:id="@+id/quantity"
                        style="@style/BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:text="1" />

                </LinearLayout>

        <!--        <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="@string/category" />

                    <TextView
                        android:id="@+id/category"
                        style="@style/TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:text="Electronics" />

                </LinearLayout>
-->
            </LinearLayout>

            <LinearLayout
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/margin">

                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/half_margin"
                    android:text="Buyer Details"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/half_margin">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/materialCardView"
                        style="@style/cardStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="100dp">

                        <ImageView
                            android:id="@+id/userProfile"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/app_name"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder_user" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/userName"
                            style="@style/TitleSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name" />

                        <TextView
                            android:id="@+id/email"
                            style="@style/BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="dfbgh"
                            android:textColor="@color/tertiary" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_outlined_message" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.5"
                    android:layout_marginVertical="@dimen/margin" />

                <TextView
                    style="@style/TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/delivery_address"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/address"
                    style="@style/BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="12 Main Road Engineering Chauraha" />

            </LinearLayout>


            <LinearLayout
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/margin">

                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/half_margin"
                    android:text="Shipping Updates"
                    app:drawableStartCompat="@drawable/ic_shipping"
                    app:drawableTint="@color/primary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/shippingRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/shipping_update_item" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:endIconDrawable="@drawable/ic_arrow_down_2"
                    android:layout_weight="1"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/status"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:layout_marginEnd="@dimen/half_margin"
                        android:focusableInTouchMode="false"
                        android:hint="Select Status" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateStatus"
                    style="@style/appBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/half_margin"
                    android:text="Update Status" />

            </LinearLayout>

            <!-- #9934033253: Buyer cancellation request — seller approve/reject.
                 Shown only when cancellation_status == "requested". -->
            <LinearLayout
                android:id="@+id/cancellationRequestSection"
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:orientation="vertical"
                android:padding="@dimen/margin"
                android:visibility="gone">

                <TextView
                    style="@style/TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancellation Requested"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cancellationReasonText"
                    style="@style/BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:alpha="0.8"
                    android:text="The buyer has requested to cancel this order." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRejectCancellation"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/half_margin"
                        android:text="Reject" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApproveCancellation"
                        style="@style/appBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/half_margin"
                        android:text="Approve" />

                </LinearLayout>

            </LinearLayout>

            <!-- ═══ Wave 4: Order Workflow Actions (#31/#32/#33/#34) ═══ -->

            <!-- #31/#32: Processing → Shipped progression -->
            <LinearLayout
                android:id="@+id/markShippedSection"
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:orientation="vertical"
                android:padding="@dimen/margin"
                android:visibility="gone">

                <TextView
                    style="@style/TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mark as Shipped"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:hint="USPS Tracking Number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/trackingNumberInput"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkShipped"
                    style="@style/appBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:text="Mark as Shipped" />

            </LinearLayout>

            <!-- #33: Get Shipping Label (shown when processing or shipped) -->
            <LinearLayout
                android:id="@+id/shippingLabelSection"
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:orientation="vertical"
                android:padding="@dimen/margin"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetShippingLabel"
                    style="@style/appBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Get Shipping Label" />

            </LinearLayout>

            <!-- #32: Tracking info display (shown when tracking_number is present) -->
            <LinearLayout
                android:id="@+id/trackingInfoSection"
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:orientation="vertical"
                android:padding="@dimen/margin"
                android:visibility="gone">

                <TextView
                    style="@style/TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tracking Information"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="Tracking #" />

                    <TextView
                        android:id="@+id/trackingNumberDisplay"
                        style="@style/TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrackPackage"
                    style="@style/appBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:text="Track Package on USPS" />

            </LinearLayout>

            <!-- #34: Order Completed badge -->
            <LinearLayout
                android:id="@+id/completedBadgeSection"
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:background="@drawable/card_16"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/margin"
                android:visibility="gone">

                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="✅ Order Completed"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <TextView
                    style="@style/BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:alpha="0.7"
                    android:layout_marginTop="@dimen/half_margin"
                    android:text="This order has been delivered and completed." />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>