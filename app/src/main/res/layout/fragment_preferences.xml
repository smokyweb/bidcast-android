<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.more.PreferencesFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerMode="BACK_BUTTON_TITLE_ACTION"
        app:headerTitle="Preferences"
        app:layout_constraintTop_toTopOf="parent"
        app:primaryIconDrawable="@drawable/ic_add"
        app:secondaryIconDrawable="@drawable/search"
        app:showBackButton="true"
        app:showPrimaryIcon="false"
        app:showSecondaryIcon="false" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:background="@color/backgroundClr"
                android:paddingHorizontal="@dimen/margin"
                android:paddingVertical="12dp"
                android:text="@string/account" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/margin"
                android:orientation="horizontal">

                <TextView
                    style="@style/TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/half_margin"
                    android:layout_weight="1"
                    android:text="@string/country_of_residence" />


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/half_margin"
                    android:layout_marginStart="@dimen/half_margin"
                    android:gravity="end"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/country"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:drawableEnd="@drawable/ic_forward"
                        android:drawablePadding="8dp"
                        android:focusable="false"
                        android:gravity="end"
                        android:inputType="none"
                        android:padding="@dimen/half_margin"
                        android:text=""
                        android:textStyle="bold" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                style="@style/TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/half_margin"
                android:alpha="0.7"
                android:background="@color/backgroundClr"
                android:paddingHorizontal="@dimen/margin"
                android:paddingVertical="12dp"
                android:text="@string/privacy" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/direct_messages"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/direct_messages" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/receive_gifts"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/receive_gifts" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/private_entry"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/enable_private_entry" />


            <TextView
                style="@style/TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/half_margin"
                android:layout_marginTop="@dimen/margin"
                android:alpha="0.7"
                android:background="@color/backgroundClr"
                android:paddingHorizontal="@dimen/margin"
                android:paddingVertical="12dp"
                android:text="@string/display" />


            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/reward_status"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/show_reward_status" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/seller_tools"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/show_seller_tools" />


            <TextView
                style="@style/TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/half_margin"
                android:layout_marginTop="@dimen/margin"
                android:alpha="0.7"
                android:background="@color/backgroundClr"
                android:paddingHorizontal="@dimen/margin"
                android:paddingVertical="12dp"
                android:text="@string/content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/enable_clips"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/enable_clips" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/save_past_shows"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/save_past_shows" />


            <TextView
                style="@style/TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/half_margin"
                android:layout_marginTop="@dimen/margin"
                android:alpha="0.7"
                android:background="@color/backgroundClr"
                android:paddingHorizontal="@dimen/margin"
                android:paddingVertical="12dp"
                android:text="@string/other_settings" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/activity_status"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/activity_status" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />

            <!--<com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sync_phone_contact"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/sync_phone_contact" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/suggest_account"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="@string/suggest_my_account" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/half_margin"
                app:dividerColor="@color/outline" />-->

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/haptic_feedback"
                style="@style/appSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginBottom="@dimen/margin"
                android:text="@string/haptic_feedback" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>