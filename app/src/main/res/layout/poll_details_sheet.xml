<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bottom_sheet_back"
    android:backgroundTint="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/HeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Poll" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/close"
                style="@style/cardStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/close_ic"
                    app:tint="@color/tertiary" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Poll Question -->
        <com.google.android.material.card.MaterialCardView
            style="@style/cardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin"
            android:backgroundTint="@color/primaryContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin">

                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/half_margin"
                    android:alpha="0.7"
                    android:text="Question"
                    android:textColor="@color/onPrimaryContainer" />

                <TextView
                    android:id="@+id/pollQuestionDetail"
                    style="@style/BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What do you prefer?"
                    android:textColor="@color/onPrimaryContainer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Timer and Total Votes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/card_16"
                android:backgroundTint="@color/errorContainer"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginEnd="@dimen/half_margin"
                android:padding="@dimen/half_margin">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:rotation="90"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/error" />

                <TextView
                    android:id="@+id/pollTimerDetail"
                    style="@style/BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/half_margin"
                    android:text="2:30 remaining"
                    android:textColor="@color/error" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/card_16"
                android:backgroundTint="@color/primaryContainer"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/half_margin"
                android:padding="@dimen/half_margin">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_poll"
                    android:tint="@color/primary" />

                <TextView
                    android:id="@+id/pollTotalVotesDetail"
                    style="@style/BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/half_margin"
                    android:text="125 total votes"
                    android:textColor="@color/primary" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/half_margin"
            android:text="Options" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/optionRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/poll_option_item"
            tools:itemCount="3"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/endPollBtn"
            style="@style/appBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin"
            android:layout_marginBottom="32dp"
            android:text="End Poll"
            android:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>




