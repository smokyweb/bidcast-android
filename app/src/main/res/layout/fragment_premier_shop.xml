<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.sellerHub.PremierShopFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerMode="BACK_BUTTON_TITLE_ACTION"
        app:headerTitle="@string/premier_shop"
        app:layout_constraintTop_toTopOf="parent"
        app:showBackButton="true"
        app:showPrimaryIcon="false"
        app:showSecondaryIcon="false" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/margin"
        app:layout_constraintBottom_toTopOf="@id/applyBtn"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:background="@drawable/card_8"
                android:backgroundTint="@color/surfaceVariant"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/onSurfaceVariant" />

                <TextView
                    android:id="@+id/welcome_text"
                    style="@style/BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin"
                    android:layout_weight="1"
                    android:text="Pro Tip text here"
                    android:textColor="@color/onSurface" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginBottom="@dimen/half_margin"
                android:elevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@drawable/card_8"
                        android:backgroundTint="@color/primary"
                        android:orientation="vertical"
                        app:layout_constraintDimensionRatio="7:4.5"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/margin"
                            android:contentDescription="@string/app_name"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_crown" />

                        <TextView
                            style="@style/HeadlineMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginHorizontal="@dimen/half_margin"
                            android:text="Become a Premier Shop"
                            android:textColor="@color/surface" />

                        <TextView
                            style="@style/BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginHorizontal="@dimen/margin"
                            android:text="Join the elite sellers and unlock exclusive benefits"
                            android:textAlignment="center"
                            android:textColor="@color/surface" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/cardStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin"
                    android:layout_marginTop="130dp"
                    android:layout_marginBottom="@dimen/margin"
                    app:cardBackgroundColor="@color/onPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/background"
                    app:strokeWidth="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="20dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/icon_card"
                                style="@style/cardStyle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:cardCornerRadius="100dp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:backgroundTint="@color/onSecondary"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_shop"
                                    android:tint="@color/primary" />

                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginHorizontal="@dimen/half_margin"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/title"
                                    style="@style/TitleLarge"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Your Shop" />

                                <TextView
                                    android:id="@+id/sub_title"
                                    style="@style/BodySmall"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Regular Member" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/orders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/half_margin"
                            app:layout_constraintTop_toBottomOf="@+id/header">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/half_margin">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/ratingProgress"
                                        style="@style/circularProgressStyle"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:max="50"
                                        android:progress="48"
                                        app:layout_constraintDimensionRatio="1:1"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:id="@+id/rating"
                                        style="@style/TitleMedium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="N/A"
                                        android:textColor="@color/tertiary"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <TextView
                                    style="@style/BodySmall"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Rating" />

                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="1dp"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/card_8"
                                android:orientation="vertical"
                                android:padding="@dimen/half_margin">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/responseProgress"
                                        style="@style/circularProgressStyle"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:max="100"
                                        android:progress="70"
                                        app:layout_constraintDimensionRatio="1:1"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:id="@+id/response"
                                        style="@style/TitleMedium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="N/A"
                                        android:textColor="@color/tertiary"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <TextView
                                    style="@style/BodySmall"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Response" />

                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="1dp"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/card_8"
                                android:orientation="vertical"
                                android:padding="@dimen/half_margin">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/deliveryProgress"
                                        style="@style/circularProgressStyle"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:progress="70"
                                        app:layout_constraintDimensionRatio="1:1"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <TextView
                                        android:id="@+id/delivery"
                                        style="@style/TitleMedium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:max="100"
                                        android:text="N/A"
                                        android:textColor="@color/tertiary"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />
                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <TextView
                                    style="@style/BodySmall"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Delivery" />

                            </LinearLayout>


                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>



            <LinearLayout
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginBottom="@dimen/margin"
                android:background="@drawable/card_16"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin"
                android:padding="@dimen/padding">
                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Policy Standing" />

                <TextView
                    android:id="@+id/policy_standards"
                    style="@style/BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginTop="@dimen/half_margin"
                    android:textColor="@color/onSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginVertical="@dimen/half_margin"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/reviewLogo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:backgroundTint="@color/onSecondary"
                        android:src="@drawable/ic_checked_tag"
                        android:tint="@color/primary" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/reviewTitle"
                            style="@style/TitleLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Monthly Evaluation" />

                        <TextView
                            android:id="@+id/reviewDetails"
                            style="@style/BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Performance reviewed every 30 days" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="Current Progress" />

                    <TextView
                        android:id="@+id/progress"
                        style="@style/TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/stepProgress"
                    style="@style/circularProgressStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/margin"
                    android:progress="9"
                    android:progressTint="@color/primary"
                    app:layout_constraintTop_toBottomOf="@id/header"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/nextReview"
                    style="@style/BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Next Review in 7 days" />
            </LinearLayout>


            <LinearLayout
                style="@style/shadowStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginBottom="@dimen/margin"
                android:background="@drawable/card_16"
                android:orientation="vertical"
                android:padding="@dimen/padding">

                <TextView
                    style="@style/TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Become a Premier Shop" />

                <TextView
                    android:id="@+id/become_text"
                    style="@style/BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginVertical="@dimen/half_margin"
                    android:textColor="@color/onSurfaceVariant" />

                <TextView
                    style="@style/TitleSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/requirements" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/requirementRecycler"
                    style="@style/shadowStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/requirement_item" />
            </LinearLayout>

            <TextView
                style="@style/TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginTop="@dimen/margin"
                android:text="Premier Benifits"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="4"
                tools:listitem="@layout/benifits_item" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/applyBtn"
        style="@style/appBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin"
        android:paddingHorizontal="@dimen/margin"
        android:text="Apply for Premier Status"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>