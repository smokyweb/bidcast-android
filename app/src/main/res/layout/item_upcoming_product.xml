<?xml version="1.0" encoding="utf-8"?>
<!-- Basecamp #9933847997 (2026-05-29): product row in UpcomingShowDetailsActivity. -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Product image -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivUpcomingProductImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@color/surfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/tvUpcomingProductTitle"
                style="@style/TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Product Name" />

            <TextView
                android:id="@+id/tvUpcomingProductPrice"
                style="@style/BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$0.00"
                android:textColor="@color/primary" />

            <!-- Auction / BuyNow badge -->
            <TextView
                android:id="@+id/tvUpcomingProductBadge"
                style="@style/BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="AUCTION"
                android:textColor="@color/onPrimary" />

            <!-- Existing pre-bid label -->
            <TextView
                android:id="@+id/tvUpcomingMyPreBid"
                style="@style/BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/secondary"
                android:text="Your pre-bid: $0.00"
                android:visibility="gone" />

            <!-- Pre-bid button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpcomingPreBid"
                style="@style/appTonalBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pre-Bid"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
