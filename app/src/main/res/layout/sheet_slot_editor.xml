<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/card_8"
        android:backgroundTint="?attr/colorOnSurface"
        android:alpha="0.2" />

    <TextView
        android:id="@+id/tvSlotEditorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure Slot"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp" />

    <!-- Color picker label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Color"
        android:textSize="13sp"
        android:alpha="0.6"
        android:textColor="?attr/colorOnSurface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp" />

    <!-- 12-color grid (3 rows × 4 cols) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp" />

    <!-- Icon picker label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Icon"
        android:textSize="13sp"
        android:alpha="0.6"
        android:textColor="?attr/colorOnSurface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp" />

    <!-- 12-icon grid (2 rows × 6 cols) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerIcons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp" />

    <!-- Pick product button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickProduct"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:text="Pick Product"
        android:textAllCaps="false" />

    <!-- Selected product indicator -->
    <TextView
        android:id="@+id/tvSelectedProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <!-- Done button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSlotDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="Done"
        android:textAllCaps="false" />

</LinearLayout>
