<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.sell.ListAProductFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <io.bidswipe.app.ui.custom.Header
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerTitle="List a Product"
            app:layout_constraintTop_toTopOf="parent"
            app:primaryIconDrawable="@drawable/notification"
            app:showBackButton="true"
            app:showPrimaryIcon="false" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/main_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:orientation="vertical">

                <io.bidswipe.app.ui.custom.Heading
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="Media" />

                <LinearLayout
                    android:id="@+id/add_new_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_8_outline"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="48dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_gallery"
                        app:tint="@color/outlineVariant" />

                    <TextView
                        style="@style/TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Photos/Videos"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Minimum 1 photo required" />

                </LinearLayout>

                <TextView
                    android:id="@+id/image_limit"
                    style="@style/TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Photos: 0/8  Video: 0/1"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/half_margin"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/upload_image_item" />


                <io.bidswipe.app.ui.custom.Heading
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    app:title="Product Details" />

                <TextView
                    style="@style/TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin"
                    app:endIconDrawable="@drawable/ic_arrow_down_2"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/category"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="@string/select_category" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sub_category_layout"
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_category" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/inputBoxStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin"
                        app:endIconDrawable="@drawable/ic_arrow_down_2"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/sub_category"
                            style="@style/inputTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:hint="@string/select_category" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
                <TextView
                    style="@style/TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="150">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/product_title"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/enter_product_title"
                        android:maxLines="3"
                        android:minLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/description" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin"
                    app:boxCornerRadiusBottomEnd="@dimen/margin"
                    app:boxCornerRadiusBottomStart="@dimen/margin"
                    app:boxCornerRadiusTopEnd="@dimen/margin"
                    app:boxCornerRadiusTopStart="@dimen/margin"
                    app:counterEnabled="true"
                    app:counterMaxLength="1000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/description"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/describe_your_product"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:maxLines="10"/>

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/quantity_available" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_8_outline"
                        android:padding="2dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/decreaseQuantity"
                            style="@style/appBtnTrans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/margin"
                            android:paddingVertical="4dp"
                            android:text="-" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/inputBoxStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/half_margin"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="0dp"
                            android:paddingVertical="0dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/quantity"
                                style="@style/inputTextStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="5"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="1"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/increaseQuantity"
                            style="@style/appBtnTrans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="@dimen/margin"
                            android:paddingVertical="4dp"
                            android:text="+" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    style="@style/TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Condition" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin"
                    app:endIconDrawable="@drawable/ic_arrow_down_2"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/condition"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="Select Product Condition" />

                </com.google.android.material.textfield.TextInputLayout>
                <io.bidswipe.app.ui.custom.Heading
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="Shipping" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconDrawable="@drawable/ic_arrow_down_2"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/shipping_profile"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="@string/select_profile" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/clear_shipping_selection"
                    style="@style/BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:alpha="0.7"
                    android:paddingTop="4dp"
                    android:text="Clear selection"
                    android:textColor="@color/primary"
                    android:visibility="gone" />

                <TextView
                    style="@style/BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin"
                    android:layout_marginBottom="@dimen/half_margin"
                    android:alpha="0.5"
                    android:text="@string/sellers_covers_ny_shipping_adjustments" />

                <LinearLayout
                    android:id="@+id/shipping_dependent_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mail Class" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/inputBoxStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin"
                        app:endIconDrawable="@drawable/ic_arrow_down_2"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/mailClass"
                            style="@style/inputTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:hint="@string/select_category" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/width_title"
                        style="@style/TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Width" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/inputBoxStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/width"
                            style="@style/inputTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Width (inches)"
                            android:inputType="numberDecimal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/height_title"
                        style="@style/TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Height" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/inputBoxStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/height"
                            style="@style/inputTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Height (inches)"
                            android:inputType="numberDecimal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/length_title"
                        style="@style/TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Length" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/inputBoxStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/length"
                            style="@style/inputTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Length (inches)"
                            android:inputType="numberDecimal" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/weight_title"
                        style="@style/TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Weight" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/inputBoxStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/weight"
                            style="@style/inputTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Weight (lbs)"
                            android:inputType="numberDecimal" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>



                <TextView
                    style="@style/TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/half_margin"
                    android:text="Processing Category" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin"
                    app:endIconDrawable="@drawable/ic_arrow_down_2"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/proCategory"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="@string/select_category" />

                </com.google.android.material.textfield.TextInputLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/variants"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/margin"
                    android:layout_weight="1"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/variant_item" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/margin">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_add" />

                        <TextView
                            style="@style/BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/half_margin"
                            android:text="@string/add_variants" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <io.bidswipe.app.ui.custom.Heading
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="Pricing" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/cardStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surfaceVariant"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabs"
                        style="@style/tabStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tabPadding="0dp">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/buy_it_now" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auction" />

                    </com.google.android.material.tabs.TabLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/title_price"
                    style="@style/TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/half_margin"
                    android:text="Price" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/inputBoxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:prefixText="$"
                    app:prefixTextAppearance="@style/BodyMedium"
                    android:layout_marginBottom="@dimen/margin"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/price"
                        style="@style/inputTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/_0_00"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/flash_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_8_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Flash Sale" />

                        <TextView
                            style="@style/BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="Turn this on to enable flash sale on this product."
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/flashSell"
                        style="@style/appSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/accept_offers_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/half_margin"
                    android:background="@drawable/card_8_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/accept_offers" />

                        <TextView
                            style="@style/BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="Turn this on to accept offers. You can accept, counter, or decline the offers."
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/acceptOffers"
                        style="@style/appSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reserve_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_8_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/reserve_for_live" />

                        <TextView
                            style="@style/BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Auction items are reserved for live shows only. This stays on while you are on the Auction tab."
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/reserveForLive"
                        style="@style/appSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_8_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/half_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hazardous Materials" />

                        <TextView
                            android:id="@+id/hazardous_desc"
                            style="@style/BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.7"
                            android:text="Carriers restrict shipping items that may pose risk to safety, like lithium batteries."
                            android:textStyle="bold" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/is_hazardous"
                        style="@style/appSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TitleLarge" />

                </LinearLayout>

                <io.bidswipe.app.ui.custom.Heading
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    app:title="@string/optional_fields" />

                <TextView
                    style="@style/BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="Set your cost per item and a SKU. This information can only be seen by you."
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/see_other_options"
                    style="@style/appBtnTrans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="@dimen/half_margin"
                    android:text="See Options"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_arrow_down_2"
                    app:iconGravity="textEnd"
                    app:iconPadding="0dp"
                    app:iconTint="@color/primary" />

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/otherOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:el_duration="400"
                    app:el_expanded="false"
                    app:el_parallax="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TitleSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cost per item" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/inputBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/cost_per_item"
                                style="@style/inputTextStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter cost per item"
                                android:inputType="numberDecimal" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <TextView
                            style="@style/TitleSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="SKU / Internal Reference" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/inputBoxStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/sku"
                                style="@style/inputTextStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Enter SKU / Internal Reference"
                                android:inputType="text" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </net.cachapa.expandablelayout.ExpandableLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin"
            android:orientation="horizontal"
            android:visibility="visible"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_draft"
                style="@style/appTonalBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/margin"
                android:text="@string/save_draft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/publish"
                style="@style/appBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/margin"
                android:text="@string/publish" />

        </LinearLayout>

    </LinearLayout>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>