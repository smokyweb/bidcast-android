<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/click"
    style="@style/shadowStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/half_margin"
    android:background="@drawable/card_8"
    android:gravity="center_vertical"
    android:padding="@dimen/margin">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/half_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/type"
                style="@style/TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/defaultAddress"
                style="@style/cardStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/half_margin"
                android:visibility="gone"
                app:cardBackgroundColor="@color/primaryContainer"
                app:cardCornerRadius="100dp">

                <TextView
                    android:id="@+id/status"
                    style="@style/BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin"
                    android:layout_marginVertical="4dp"
                    android:text="Default"
                    android:textColor="@color/primary" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <TextView
            android:id="@+id/name"
            style="@style/BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="John Smith" />

        <TextView
            android:id="@+id/address"
            style="@style/BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin"
            android:alpha="0.7"
            android:text="465 Bussiness Ave , Suit 200 New York" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/moreIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:alpha="0.7"
        android:rotation="90"
        android:layout_gravity="top"
        android:src="@drawable/ic_detail" />

</LinearLayout>