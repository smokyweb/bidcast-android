<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/cardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Template name -->
        <TextView
            android:id="@+id/tvTemplateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnEditTemplate"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Type chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipTemplateType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            app:chipMinHeight="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTemplateName"
            android:layout_marginTop="4dp" />

        <!-- Slot count -->
        <TextView
            android:id="@+id/tvSlotCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/chipTemplateType"
            app:layout_constraintTop_toTopOf="@+id/chipTemplateType"
            app:layout_constraintBottom_toBottomOf="@+id/chipTemplateType" />

        <!-- Action buttons -->
        <ImageView
            android:id="@+id/btnReleaseProducts"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_gift"
            android:padding="4dp"
            android:contentDescription="Release products"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteTemplate"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/btnDeleteTemplate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_trash"
            android:padding="4dp"
            android:contentDescription="Delete template"
            app:tint="@color/error"
            app:layout_constraintEnd_toStartOf="@+id/btnEditTemplate"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/btnEditTemplate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_edit"
            android:padding="4dp"
            android:contentDescription="Edit template"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
