<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".ui.sellerHub.shipping.DomesticShipmentsFragment">

    <io.bidswipe.app.ui.custom.Header
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="Domestic Shipments"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showBackButton="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height = "0dp"
        app:layout_constraintBottom_toTopOf = "@id/bottomLayout"
        app:layout_constraintTop_toBottomOf = "@+id/header" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelInstructions"
                style="@style/BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin"
                android:text="All orders falling outside of your shipping preferences will default to USPS Ground Advantage. Eligible sellers will default to Media Mail shipping." />

            <TextView
                style="@style/TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="Eligible Shipments under 3 oz"
                android:textSize="16dp" />

            <LinearLayout
                style="@style/shadowStyle"
                android:background="@drawable/card_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_marginVertical="@dimen/half_margin"
                android:padding="@dimen/margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TitleMedium"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="USPS First-Class Mail Letter" />

                    <TextView
                        style="@style/BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="For shipments under $20 that weigh 3 oz or less in Trading Card Games, Sports Cards, or Stickers categories. View the full criteria here." />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/free_pickup"
                    style="@style/appSwitch"
                    android:layout_marginStart="@dimen/half_margin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TitleLarge" />

            </LinearLayout>

            <TextView
                style="@style/TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="Domestic Shipments from 1 to 5 lbs"
                android:textSize="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/domestic_1_5_recycler"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/half_margin"
                tools:itemCount="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/domestic_shipment_item" />

            <TextView
                style="@style/TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:layout_marginHorizontal="@dimen/margin"
                android:text="Domestic Shipments over 5 lbs"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/domestic_5_recycler"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/half_margin"
                tools:itemCount="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/domestic_shipment_item" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id = "@+id/bottomLayout"
        android:layout_width = "match_parent"
        android:layout_height = "wrap_content"
        android:orientation = "vertical"
        app:layout_constraintBottom_toBottomOf = "parent" >

            <com.google.android.material.checkbox.MaterialCheckBox
                style = "@style/appCheckbox"
                android:layout_width = "match_parent"
                android:layout_height = "wrap_content"
                android:layout_marginHorizontal = "@dimen/margin"
                android:layout_marginTop = "@dimen/margin"
                android:minHeight = "0dp"
                android:text = "Also apply to scheduled shows"
                android:textAppearance = "@style/TitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id = "@+id/save"
            style = "@style/appBtn"
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:layout_margin = "16dp"
            android:text = "Save" />

    </LinearLayout >

</androidx.constraintlayout.widget.ConstraintLayout>