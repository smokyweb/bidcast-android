<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.watchStream.WatchStreamFragment">

    <FrameLayout
        android:id="@+id/hostView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controls_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/center_gradient">

            <LinearLayout
                android:id="@+id/profileLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_card"
                    style="@style/cardStyle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/userImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_image" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/half_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/userName"
                        style="@style/TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/username"
                        android:textColor="@color/surface"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/half_margin">

                        <TextView
                            android:id="@+id/rating"
                            style="@style/TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_star"
                            android:drawablePadding="2dp"
                            android:drawableTint="@color/onPrimary"
                            android:gravity="center_vertical"
                            android:text="5.0"
                            android:textColor="@color/onPrimary" />

                        <TextView
                            style="@style/TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center_vertical"
                            android:text="•"
                            android:textColor="@color/onPrimary" />


                        <TextView
                            android:id="@+id/shipping"
                            style="@style/TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/half_margin"
                            android:drawableStart="@drawable/ic_shipping"
                            android:drawablePadding="2dp"
                            android:drawableTint="@color/onPrimary"
                            android:gravity="center_vertical"
                            android:text="1d"
                            android:textColor="@color/onPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/follow"
                            style="@style/appBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="2dp"
                            android:text="Follow"
                            android:textSize="14sp"
                            app:cornerRadius="24dp" />
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/liveCount"
                    style="@style/appTonalBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginEnd="@dimen/half_margin"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="0"
                    android:textSize="12sp"
                    app:backgroundTint="@color/black25"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_broadcast"
                    app:iconPadding="6dp"
                    app:iconSize="20sp"
                    app:iconTint="@null" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rehearsal"
                    style="@style/cardStyle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom"
                    app:cardBackgroundColor="@color/black25"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/cutButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:src="@drawable/ic_down"
                        android:tint="@color/surface" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileLayout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/view2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:layout_constraintBottom_toTopOf="@id/controls" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view2">

                        <LinearLayout
                            android:id="@+id/controls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recycler"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginEnd="32dp"
                                    android:nestedScrollingEnabled="true"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                    app:layout_constraintBottom_toTopOf="@id/message"
                                    app:layout_constraintDimensionRatio="1:1"
                                    app:reverseLayout="false"
                                    app:stackFromEnd="true"
                                    tools:itemCount="10"
                                    tools:listitem="@layout/live_comment_item" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/message"
                                    style="@style/inputBoxStyle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/margin"
                                    android:layout_marginBottom="@dimen/margin"
                                    app:boxBackgroundColor="@color/transparent"
                                    app:boxStrokeColor="@color/input_box_stroke_color_surface"
                                    app:layout_constraintBottom_toTopOf="@+id/product">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/message_text"
                                        style="@style/inputTextStyle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:minHeight="0dp"
                                        android:paddingVertical="8dp"
                                        android:hint="@string/say_something"
                                        android:inputType="text"
                                        android:imeOptions="actionSend"
                                        android:textColor="@color/surface"
                                        android:textColorHint="@color/surfaceVariant" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/side_options"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toTopOf="@+id/message"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/rehearsalLayout">

                                <LinearLayout
                                    android:id="@+id/gift"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_gift_outlined"
                                        android:tint="@color/surface" />

                                    <TextView
                                        style="@style/TextAppearance.Material3.LabelSmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Gift"
                                        android:textColor="@color/surface" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/promote"
                                    android:layout_marginBottom="8dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_clip_new"
                                        android:tint="@color/surface" />

                                    <TextView
                                        style="@style/LabelLarge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Clip"
                                        android:textColor="@color/surface" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/share"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/share"
                                        android:tint="@color/surface" />

                                    <TextView
                                        style="@style/LabelLarge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Share"
                                        android:textColor="@color/surface" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/wallet"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_horizontal"
                                    android:layout_marginBottom="8dp"
                                    android:orientation="vertical">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_wallet_outlined"
                                        android:tint="@color/surface" />

                                    <TextView
                                        style="@style/LabelLarge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Wallet"
                                        android:textColor="@color/surface" />

                                </LinearLayout>

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="wrap_content"
                                    android:layout_marginTop="@dimen/half_margin"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="40dp"
                                        style="@style/cardStyle"
                                        android:layout_height="52dp"
                                        app:cardElevation="0dp"
                                        app:cardBackgroundColor="@color/surface"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="44dp"
                                        android:layout_height="44dp"
                                        android:layout_marginTop="4dp"
                                     app:cardElevation="2dp"
                                        style="@style/cardStyle"
                                        app:cardBackgroundColor="@color/surface"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:scaleType="centerCrop"
                                            android:src="@drawable/product_img"/>

                                    </com.google.android.material.card.MaterialCardView>

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:layout_marginTop="8dp"
                                        android:id="@+id/shop"
                                        app:cardBackgroundColor="@color/surface"
                                        app:cardElevation="3dp"
                                        style="@style/cardStyle"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" >
                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:id="@+id/product_image_shop"
                                            android:src="@drawable/placeholder_square"
                                            android:scaleType="centerCrop"/>
                                    </com.google.android.material.card.MaterialCardView>

                                    <TextView
                                        style="@style/LabelLarge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Shop"
                                        android:textColor="@color/surface"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toBottomOf="@id/shop"
                                        app:layout_constraintBottom_toBottomOf="parent" />
                                    <TextView
                                        android:id="@+id/count_badge"
                                        style="@style/LabelMedium"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:background="@drawable/card_16"
                                        android:backgroundTint="@color/primary"
                                        android:gravity="center"
                                        android:text="1"
                                        android:elevation="4dp"
                                        android:textColor="@color/onError"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/poll"
                            style="@style/cardStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin"
                            android:layout_marginBottom="@dimen/margin"
                            android:backgroundTint="@color/black25"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="@dimen/half_margin">

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/cardStyle"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:backgroundTint="@color/primaryContainer"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="12dp"
                                        android:src="@drawable/ic_poll"
                                        android:tint="@color/primary" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/margin"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/pollQuestionPreview"
                                        style="@style/TitleMedium"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="What do you prefer?"
                                        android:textColor="@color/surface" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/pollTimerPreview"
                                            style="@style/BodySmall"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="2:30 remaining"
                                            android:textColor="@color/error"
                                            android:textSize="12sp" />

                                        <View
                                            android:layout_width="4dp"
                                            android:layout_height="4dp"
                                            android:layout_marginHorizontal="8dp"
                                            android:alpha="0.5"
                                            android:background="@drawable/card_16"
                                            android:backgroundTint="@color/surface" />

                                        <TextView
                                            android:id="@+id/pollTotalVotesPreview"
                                            style="@style/BodySmall"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.7"
                                            android:text="125 votes"
                                            android:textColor="@color/surface"
                                            android:textSize="12sp" />

                                    </LinearLayout>

                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="@dimen/half_margin"
                                    android:alpha="0.7"
                                    android:src="@drawable/ic_forward"
                                    android:tint="@color/surface" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/product"
                            style="@style/cardStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin"
                            android:layout_marginBottom="@dimen/margin"
                            android:backgroundTint="@color/transparent"
                            android:elevation="0dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toTopOf="@id/bidLayout"
                            app:layout_constraintStart_toStartOf="parent">

                            <LinearLayout
                                android:id="@+id/product_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/winningLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingVertical="4dp"
                                    android:visibility="gone">

                                    <com.google.android.material.card.MaterialCardView
                                        style="@style/cardStyle"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:background="@color/transparent"
                                        app:cardCornerRadius="100dp"
                                        app:cardElevation="0dp">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:id="@+id/winnerImage"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:scaleType="centerCrop"
                                            android:src="@drawable/placeholder_user" />

                                    </com.google.android.material.card.MaterialCardView>

                                    <TextView
                                        android:id="@+id/winning"
                                        style="@style/TitleSmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="@dimen/half_margin"
                                        android:text="Jack lee is winning!"
                                        android:textColor="@color/onPrimary" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <com.google.android.material.card.MaterialCardView
                                        style="@style/cardStyle"
                                        android:layout_width="72dp"
                                        android:layout_height="72dp"
                                        app:cardCornerRadius="8dp"
                                        app:cardElevation="0dp">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:id="@+id/productImage"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:scaleType="centerCrop"
                                            android:src="@drawable/shoe" />

                                    </com.google.android.material.card.MaterialCardView>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="@dimen/half_margin"
                                        android:layout_weight="1"
                                        android:gravity="center_vertical"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/productName"
                                            style="@style/TitleMedium"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="White Sneakers"
                                            android:textColor="@color/surface" />

                                        <TextView
                                            android:id="@+id/product_category"
                                            style="@style/BodySmall"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Sports &amp; Lifestyle"
                                            android:textColor="@color/surface" />

                                        <TextView
                                            android:id="@+id/quantity"
                                            style="@style/BodySmall"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="Quantity: 1"
                                            android:textColor="@color/surface"
                                            android:visibility="gone" />

                                        <TextView
                                            android:id="@+id/price"
                                            style="@style/LabelLarge"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="$1"
                                            android:textColor="@color/surface" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="4dp"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/bid_price"
                                            style="@style/TitleMedium"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="$20"
                                            android:textColor="@color/onPrimary" />

                                        <TextView
                                            android:id="@+id/bid_time"
                                            style="@style/BodySmall"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:drawableStart="@drawable/skull"
                                            android:drawablePadding="4dp"
                                            android:text="00:00:00"
                                            android:visibility="gone"
                                            android:textColor="@color/error" />

                                        <TextView
                                            android:id="@+id/status"
                                            style="@style/BodySmall"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="Sold"
                                            android:visibility="gone"
                                            android:textColor="@color/error" />

                                    </LinearLayout>

                                </LinearLayout>


                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/sold_layout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/half_margin"
                                android:layout_marginHorizontal="@dimen/half_margin"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/soldOutText"
                                    style="@style/TitleLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sold Out!"
                                    android:textColor="@color/surface" />

                                <TextView
                                    style="@style/BodySmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Please wait for next product"
                                    android:textColor="@color/surface" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:id="@+id/bidLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin"
                            android:layout_marginBottom="@dimen/half_margin"
                            android:gravity="center_vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/max"
                                style="@style/appBtnOutline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/half_margin"
                                android:backgroundTint="@color/transparent"
                                android:minHeight="0dp"
                                android:paddingHorizontal="@dimen/half_margin"
                                android:paddingVertical="8dp"
                                android:text="Custom"
                                android:textColor="@color/surfaceVariant"
                                android:textSize="14sp"
                                app:cornerRadius="24dp"
                                app:strokeColor="@color/surfaceVariant"
                                app:strokeWidth="1dp" />

                            <com.ncorti.slidetoact.SlideToActView
                                android:id="@+id/bid1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:visibility="gone"
                                app:animation_duration="250"
                                app:area_margin="4dp"
                                app:border_radius="8dp"
                                app:bounce_on_start="true"
                                app:icon_margin="12dp"
                                app:inner_color="@color/secondaryContainer"
                                app:outer_color="@color/primary"
                                app:slider_height="48dp"
                                app:slider_icon="@drawable/ic_dollar_2"
                                app:slider_icon_color="@color/onSurface"
                                app:slider_locked="false"
                                app:text="Swipe to Bid"
                                app:text_appearance="@style/SlideButtonTitle" />


                            <com.google.android.material.card.MaterialCardView
                                style="@style/cardStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/transparent"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/primary"
                                app:strokeWidth="1.5dp">

                                <com.zerobranch.layout.SwipeLayout
                                    android:id="@+id/bid_swipe_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="3dp"
                                    app:draggedItem="@id/bid_button"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:leftItem="@id/lefttt"
                                    app:swipeDirection="right">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/bid_button"
                                        style="@style/appBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="64dp"
                                        android:minHeight="0dp"
                                        android:paddingVertical="6dp"
                                        android:text="Bid Start Soon"
                                        app:cornerRadius="28dp" />

                                    <View
                                        android:id="@+id/lefttt"
                                        android:layout_width="64dp"
                                        android:layout_height="24dp" />

                                </com.zerobranch.layout.SwipeLayout>

                            </com.google.android.material.card.MaterialCardView>


                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center" />

    </ViewFlipper>

    <io.bidswipe.app.ui.custom.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>