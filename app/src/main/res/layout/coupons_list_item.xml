<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/click"
    style="@style/shadowStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/half_margin"
    android:background="@drawable/card_8"
    android:gravity="center_vertical"
    android:padding="12dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/defaultAddress"
        style="@style/cardStyle"
        android:layout_width="85dp"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:cardBackgroundColor="@color/primaryContainer"
        app:cardCornerRadius="8dp">

        <TextView
            android:id="@+id/percentage"
            style="@style/TitleSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25% \n OFF"
            android:layout_gravity="center"
            android:textColor="@color/primary" />

    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/half_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/coupon_code"
            style="@style/TitleSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Code: 2#STRSS" />

        <TextView
            android:id="@+id/desc"
            style="@style/BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="This coupon applies only to orders up to a maximum of $500" />

        <TextView
            android:id="@+id/valid_upto"
            style="@style/BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="Valid until: 25/02/2026" />

    </LinearLayout>



</LinearLayout>