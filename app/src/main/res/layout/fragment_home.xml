<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:context=".ui.dashboard.HomeFragment">

	<io.bidswipe.app.ui.custom.Header
		android:id="@+id/header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		app:headerMode="APP_TEXT_ACTION"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:primaryIconDrawable="@drawable/notification"
		app:secondaryIconDrawable="@drawable/search"
		app:showBackButton="false"
		app:showPrimaryIcon="true"
		app:showSecondaryIcon="true" />

	<HorizontalScrollView
		android:id="@+id/chipGroupScroll"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:scrollbars="none"
		android:layout_marginHorizontal="0dp"
		app:layout_constraintTop_toBottomOf="@id/header">

		<com.google.android.material.chip.ChipGroup
			android:id="@+id/chipGroup"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="@dimen/half_margin"
			android:layout_marginTop="@dimen/margin"
			android:layout_marginEnd="@dimen/margin"
			android:layout_marginBottom="@dimen/margin"
			android:paddingHorizontal="4dp"
			app:singleLine="true"
			app:singleSelection="true" />

	</HorizontalScrollView>

	<LinearLayout
		android:id="@+id/heading"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginHorizontal="@dimen/margin"
		android:layout_marginBottom="@dimen/margin"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/chipGroupScroll">
		<TextView
			android:id="@+id/live"
			style="@style/TitleLarge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:text="@string/live_now"
			/>

		<com.google.android.material.divider.MaterialDivider
			android:layout_width="2dp"
			android:layout_height="match_parent"
			android:layout_marginVertical="4dp"
			android:layout_marginHorizontal="@dimen/half_margin"/>

		<TextView
			android:id="@+id/popular"
			style="@style/TitleLarge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:text="@string/popular" />

		<com.google.android.material.divider.MaterialDivider
			android:layout_width="2dp"
			android:layout_height="match_parent"
			android:layout_marginVertical="4dp"
			android:layout_marginHorizontal="@dimen/half_margin"/>

		<TextView
			android:id="@+id/comingSoon"
			style="@style/TitleLarge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:text="@string/comming_soon"
			/>

	</LinearLayout>

	<!--<TextView
		android:id="@+id/heading"
		style="@style/HeadlineSmall"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_marginHorizontal="@dimen/margin"
		android:text="@string/live_now"
		 />-->

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recycler"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_margin="@dimen/half_margin"
		android:orientation="vertical"
		app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintTop_toBottomOf="@id/heading"
		app:spanCount="2"
		tools:itemCount="6"
		tools:listitem="@layout/home_item" />

	<io.bidswipe.app.ui.custom.NoDataView
		android:id="@+id/noData"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:title_text="No Shows Found"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@id/heading"
		app:layout_constraintBottom_toBottomOf="parent"/>

	<io.bidswipe.app.ui.custom.LoaderView
		android:id="@+id/loader"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>