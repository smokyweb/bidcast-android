<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
     <View
    android:id="@+id/bottomSheetBackgroundLayer"
    android:background="@color/outline"
    android:layout_width="match_parent"
    android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/margin"
        android:background="@drawable/top_curve"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:layout_width="64dp"
            android:backgroundTint="@color/outlineVariant"
            android:layout_gravity="center"
            android:background="@drawable/card_16"
            android:layout_marginVertical="16dp"
            android:layout_height="4dp"/>
        <LinearLayout
            android:id="@+id/headingCon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TitleLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/margin"
                android:layout_weight="1"
                android:textSize="22dp"
                android:text="Sell On BidCast" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/margin"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/close_ic" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/margin"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/sell_sheet_item" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>