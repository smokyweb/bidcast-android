<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin"
        android:background="@drawable/bottom_sheet_back"
        app:layout_constraintTop_toTopOf="parent">


        <View
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_16"
            android:backgroundTint="@color/outlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TitleLarge"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/create_clip" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="@dimen/half_margin"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_close"
                app:tint="@color/onSurface"/>

        </LinearLayout>

        <!-- Basecamp #9929851737 (2026-05-27): clip duration picker, redux.
             Per Trey's spec: default 30s, slider 1..60s, user confirms via
             Create Clip. After the clip is created, the preview + SAVE/CANCEL
             buttons appear (see bottom_layout). -->
        <LinearLayout
            android:id="@+id/durationPickerWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/margin"
            android:layout_marginBottom="@dimen/half_margin">

            <TextView
                style="@style/TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clip duration" />

            <TextView
                style="@style/BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/half_margin"
                android:text="Drag to choose how many seconds of the stream to capture (1–60s)." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.slider.Slider
                    android:id="@+id/durationSlider"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="60"
                    android:stepSize="1"
                    android:value="30" />

                <TextView
                    android:id="@+id/durationValueText"
                    style="@style/TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:gravity="end"
                    android:layout_marginStart="@dimen/half_margin"
                    android:text="30s" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createClipBtn"
                style="@style/appBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin"
                android:text="@string/create_clip" />

        </LinearLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_marginVertical="@dimen/margin"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="240sp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/primaryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/loader_view"
            style="@style/appLoader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin"
            android:elevation="2dp" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Basecamp #9929851737 (2026-05-27): post-clip review row.
             Replaced the static "Trim Clip / Edit" placeholder with explicit
             SAVE / CANCEL buttons per Trey's spec. SAVE dismisses (clip is
             already persisted server-side by /api/make-clip). CANCEL also
             dismisses; no delete endpoint exists yet -> see TODO in Kotlin. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:id="@+id/bottom_layout"
            android:layout_marginVertical="@dimen/margin"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelClipBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/half_margin"
                android:text="Cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveClipBtn"
                style="@style/appBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/half_margin"
                android:text="Save" />

        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/create"
            android:visibility="gone"
            style="@style/appBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/create_clip"
            app:layout_constraintBottom_toBottomOf="parent" />

    </LinearLayout>
