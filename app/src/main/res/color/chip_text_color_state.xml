<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled chips. -->
    <item android:alpha="0.8" android:color="@color/onPrimaryContainer" android:state_enabled="false" />
    <!-- Selected chips. -->
    <item android:color="@color/onPrimary" android:state_selected="true" />
    <!-- Not-selected chips. -->
    <item android:color="@color/scrim" />
</selector>
