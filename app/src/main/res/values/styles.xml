	<!--NAVIGATION BARs STYLES-->
	<style name="navStyle" parent="Widget.Design.NavigationView">
		<item name="android:layout_gravity">end|bottom</item>
		<item name="android:layout_marginBottom">0dp</item>
		<item name="itemIconTint">@color/menu_item_color_state</item>
		<item name="itemRippleColor">@color/onPrimaryContainer</item>
		<item name="itemTextColor">@color/menu_item_color_state</item>
		<item name="itemBackground">@drawable/menu_background_color_state</item>
		<item name="itemTextAppearance">@style/TitleMedium</item>
		<item name="itemHorizontalPadding">32dp</item>
		<!--        <item name = "itemShapeAppearanceOverlay" >@style/noShape</item >-->
		<item name="itemShapeInsetBottom">0dp</item>
		<item name="itemShapeInsetEnd">0dp</item>
		<item name="itemShapeInsetStart">0dp</item>
		<item name="itemShapeInsetTop">0dp</item>
		<item name="itemVerticalPadding">@dimen/margin</item>
	</style>

	<style name="popupMenuStyle" parent="Widget.Material3.PopupMenu">
		<item name="actionMenuTextColor">@color/primary</item>
		<item name="colorControlNormal">@color/surface</item>
	</style>

	<style name="toolTipStyle" parent="Widget.Material3.Tooltip">
		<item name="android:textAppearance">@style/LabelMedium</item>
		<item name="android:textColor">@color/onPrimary</item>
		<item name="backgroundTint">@color/primary</item>
		<item name="android:padding">8dp</item>
		<item name="android:minWidth">28dp</item>
		<item name="android:minHeight">28dp</item>
		<item name="shapeAppearance">@style/ShapeAppearance.Material3.Tooltip</item>
	</style>

	<style name="sliderStyle" parent="Widget.Material3.Slider">
		<item name="thumbColor">@color/primary</item>
		<item name="trackHeight">10dp</item>
		<item name="thumbRadius">12dp</item>
		<item name="thumbStrokeColor">@color/surface</item>
		<item name="thumbStrokeWidth">2dp</item>
		<item name="trackColorActive">@color/primary</item>
		<item name="trackColorInactive">@color/primaryContainer</item>
		<!--        <item name="labelStyle">@style/MyTooltip</item>-->
	</style>

	<style name="MyTooltip" parent="Widget.MaterialComponents.Tooltip">
		<item name="backgroundTint">@color/primary</item>
	</style>

	<style name="progressStyle" parent="Widget.Material3.LinearProgressIndicator">
		<item name="android:progressTint">@color/secondary</item>
		<item name="indicatorColor">@color/secondary</item>
		<item name="trackColor">@color/onSecondary</item>
		<item name="trackCornerRadius">20dp</item>
		<item name="trackThickness">12dp</item>
		<item name="android:progress">0</item>
		<item name="android:max">100</item>
	</style>

	<style name="calenderRangeStyle" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
		<item name="materialCalendarStyle">@style/calendarStyle</item>
		<item name="materialCalendarYearNavigationButton">@style/calendarYearButton</item>
		<item name="materialCalendarMonthNavigationButton">@style/calendarYearButton</item>
		<item name="materialCalendarHeaderToggleButton">@style/calendarToggleButton</item>
	</style>

	<style name="calendarStyle">
		<item name="headerColor">@color/onPrimary</item>
		<item name = "headerLabelColor" >@color/scrim</item >
		<item name = "todayLabelColor" >@color/scrim</item >
		<item name = "selectionColor" >@color/secondary</item >
		<item name = "selectionLabelColor" >@color/surface</item >
		<item name = "highlightedDaysLabelsColor" >@color/primary</item >
		<item name = "abbreviationsBarColor" >@android:color/transparent</item >
		<item name = "eventsEnabled" >false</item >
		<item name = "swipeEnabled" >true</item >
		<item name = "type" >one_day_picker</item >
		<item name = "firstDayOfWeek" >sunday</item >
		<item name = "background" >@drawable/card_16</item >
	</style >

