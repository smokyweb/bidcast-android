		<item name="strokeWidth">0dp</item>
		<item name="chipEndPadding">6dp</item>
		<item name="chipStartPadding">6dp</item>
		<item name="chipCornerRadius">@dimen/padding</item>
		<item name="android:textColor">@color/chip_text_color_state</item>
		<item name="android:textAppearance">@style/BodyMedium</item>
	</style>


