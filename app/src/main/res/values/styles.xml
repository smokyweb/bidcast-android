<resources xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

	<style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
		<item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
		<item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>

		<item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
		<item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
	</style>

	<style name="inputBoxStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
		<!--TEXT STYLE-->
		<item name="android:textAppearance">@style/BodyMedium</item>
		<item name="android:textColor">@color/onBackground</item>
		<!--        <item name="android:maxLines">5</item>-->
		<!--        <item name="android:minLines">4</item>-->
		<!--        <item name="maxLines">5</item>-->

		<!--TEXT BOX STYLE-->
		<item name="boxStrokeColor">@color/input_box_stroke_color_state</item>
		<item name="boxBackgroundColor">@color/inverseOnSurface</item>
		<item name="errorEnabled">false</item>
		<item name="hintEnabled">false</item>
		<item name="thumbColor">@color/onBackground</item>
		<item name="colorAccent">@color/primary</item>
		<item name="expandedHintEnabled">false</item>
		<item name="boxStrokeWidth">2dp</item>
		<item name="boxStrokeWidthFocused">2dp</item>
		<item name="boxCornerRadiusBottomStart">6dp</item>
		<item name="boxCornerRadiusBottomEnd">6dp</item>
		<item name="boxCornerRadiusTopStart">6dp</item>
		<item name="boxCornerRadiusTopEnd">6dp</item>

		<!--MISC. COLOR-->
		<item name="hintTextColor">@color/outline</item>
		<item name="startIconTint">@color/outlineVariant</item>
		<item name="endIconTint">@color/outlineVariant</item>
		<item name="passwordToggleTint">@color/outlineVariant</item>
		<item name="hintTextAppearance">@style/BodyMedium</item>
		<item name="counterTextAppearance">@style/LabelMedium</item>
		<item name="counterOverflowTextAppearance">@style/LabelMedium</item>

		<!--TEXT CONTROLLER COLOR-->
		<item name="colorControlActivated">@color/primary</item>
		<item name="colorControlNormal">@color/primary</item>
		<item name="colorControlHighlight">@color/primary</item>
		<item name="android:colorControlActivated">@color/primary</item>
		<item name="android:colorControlNormal">@color/primary</item>
		<item name="android:colorControlHighlight">@color/primary</item>

	</style>

	<style name="inputText" parent="BodyMedium">
		<!--		<item name="android:paddingVertical">18dp</item>-->
		<!--		<item name="android:paddingHorizontal">12dp</item>-->
		<item name="android:textAppearance">@style/BodyLarge</item>
		<item name="android:textColor">@color/onPrimary</item>
		<item name="android:textColorHint">@color/outline</item>
		<item name="thumbColor">@color/primary</item>
	</style>

	<style name="inputTextStyle" parent="BodyMedium">
		<item name="android:padding">16dp</item>
		<item name="android:textAppearance">@style/BodySmall</item>
		<item name="android:textColor">@color/onSurface</item>
		<item name="android:textColorHint">@color/outlineVariant</item>
	</style>

	<style name="textBoxFillDropDown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
		<!--TEXT STYLE-->
		<item name="android:textAppearance">@style/BodyMedium</item>
		<item name="android:textColor">@color/onBackground</item>

		<!--TEXT BOX STYLE-->
		<item name="boxStrokeColor">@color/input_box_stroke_color_state</item>
		<item name="boxBackgroundColor">@color/surface</item>
		<item name="errorEnabled">false</item>
		<item name="hintEnabled">false</item>
		<item name="boxStrokeWidth">1dp</item>
		<item name="boxStrokeWidthFocused">1dp</item>
		<item name="boxCornerRadiusBottomStart">24dp</item>
		<item name="boxCornerRadiusBottomEnd">24dp</item>
		<item name="boxCornerRadiusTopStart">24dp</item>
		<item name="boxCornerRadiusTopEnd">24dp</item>

		<!--MISC. COLOR-->
		<item name="endIconTint">@color/primary</item>
		<item name="errorTextAppearance">@style/BodyMedium</item>
		<item name="android:textColorHint">@color/onBackground</item>
		<item name="boxStrokeErrorColor">@color/error</item>
		<item name="hintTextColor">@color/onBackground</item>
		<item name="startIconTint">@color/primary</item>
		<item name="passwordToggleTint">@color/onBackground</item>
		<item name="hintTextAppearance">@style/BodyMedium</item>
		<item name="counterTextAppearance">@style/LabelMedium</item>
		<item name="counterOverflowTextAppearance">@style/LabelMedium</item>

		<!--TEXT CONTROLLER COLOR-->
		<item name="colorControlActivated">@color/primary</item>
		<item name="colorControlNormal">@color/primary</item>
		<item name="colorControlHighlight">@color/primary</item>
		<item name="android:colorControlActivated">@color/primary</item>
		<item name="android:colorControlNormal">@color/primary</item>
		<item name="android:colorControlHighlight">@color/primary</item>
	</style>

	<!--BUTTON STYLES-->
	<style name="appBtn" parent="Widget.Material3.Button.UnelevatedButton">
		<item name="cornerRadius">8dp</item>
		<item name="backgroundTint">@color/primary</item>
		<item name="rippleColor">@color/outline</item>
		<item name="android:textColor">@color/onPrimary</item>
		<item name="textAllCaps">false</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:elevation">0dp</item>
		<item name="android:textAppearance">@style/Button</item>
		<item name="android:paddingVertical" tools:targetApi="26">12dp</item>
		<item name="android:paddingHorizontal" tools:targetApi="26">64dp</item>
		<item name="elevation">4dp</item>
		<item name="iconSize">24dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
	</style>

	<style name="appTonalBtn" parent="appBtn">
		<item name="backgroundTint">@color/onPrimaryContainer</item>
		<item name="rippleColor">@color/onPrimary</item>
		<item name="android:textColor">@color/onPrimary</item>
	</style>

	<style name="appBtnOutline" parent="appBtn">
		<item name="backgroundTint">@color/surface</item>
		<item name="android:backgroundTint">@color/surface</item>
		<item name="rippleColor">@color/primaryContainer</item>
		<item name="android:textColor">@color/primary</item>
		<item name="strokeColor">@color/primary</item>
		<item name="strokeWidth">2dp</item>
	</style>

	<style name="appBtnTrans" parent="appBtn">
		<item name="backgroundTint">@color/surface</item>
		<item name="rippleColor">@color/outline</item>
		<item name="strokeColor">@color/background</item>
		<item name="strokeWidth">2dp</item>
		<item name="android:textColor">@color/background</item>
	</style>

	<!--BOTTOM-SHEET STYLE-->
	<style name="BottomSheetDialogStyle" parent="@style/Theme.Material3.DayNight.BottomSheetDialog">
		<item name="bottomSheetStyle">@style/BottomSheetAppearance</item>
		<item name="background">@android:color/transparent</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowIsFloating">false</item>
		<item name="android:windowLightStatusBar">false</item>
		<item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
		<item name="android:statusBarColor">@color/surface</item>
		<item name="android:navigationBarColor">@color/surface</item>
	</style>

	<style name="BottomSheetAppearance" parent="Widget.Material3.BottomSheet">
		<item name="shapeAppearanceOverlay">@style/largeShape</item>
		<item name="background">@android:color/transparent</item>
		<item name="android:backgroundTint">@android:color/transparent</item>
		<item name="android:elevation" app:ignore="NewApi">0dp</item>
	</style>

	<style name="shadowStyle">
		<item name="android:elevation">2dp</item>
		<item name="cardBackgroundColor">@color/background</item>
		<item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/inverseSurface</item>
		<item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/inverseSurface
		</item>
	</style>

	<!--CARD STYLE-->
	<style name="cardStyle" parent="Widget.Material3.CardView.Filled">
		<item name="cardElevation">2dp</item>
		<item name="cardMaxElevation">1dp</item>
		<item name="cardCornerRadius">8dp</item>
		<item name="android:outlineProvider">background</item>
		<item name="cardBackgroundColor">@color/surface</item>
		<item name="rippleColor">@color/surfaceVariant</item>
		<item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/tertiary</item>
		<item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/tertiary</item>
	</style>

	<style name="appLoader">
		<item name="SpinKit_Color">@color/primary</item>
		<item name="SpinKit_Style">ThreeBounce</item>
	</style>

	<!--<style name="swipeStyle">
		<item name="preview">none</item>
		<item name="autoClose">true</item>
		<item name="designer">@string/parallax_designer</item>
	</style>-->

	<style name="tabStyle" parent="Widget.Material3.TabLayout">
		<item name="enforceTextAppearance">false</item>
		<item name="android:background">@drawable/card_8</item>
		<item name="android:backgroundTint">@color/surface</item>
		<item name="tabIndicatorAnimationDuration">500</item>
		<item name="tabIndicator">@drawable/card_8</item>
		<item name="tabIndicatorColor">@color/background</item>
		<item name="tabTextAppearance">@style/TitleMedium</item>
		<item name="tabTextColor">@color/outlineVariant</item>
		<item name="tabSelectedTextColor">@color/onBackground</item>
		<item name="tabIndicatorGravity">stretch</item>
		<item name="tabIndicatorAnimationMode">elastic</item>
		<item name="tabIndicatorFullWidth">true</item>
		<item name="elevation">0dp</item>
		<item name="tabMode">fixed</item>
		<item name="tabMaxWidth">0dp</item>
		<item name="tabGravity">fill</item>
	</style>

	<style name="callFabStyle" parent="ThemeOverlay.Material3.FloatingActionButton.Primary">
		<item name="backgroundTint">@color/primary</item>
		<item name="elevation">2dp</item>
		<item name="tint">@color/onPrimary</item>
		<item name="android:layout_margin">8dp</item>
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="shapeAppearanceOverlay">@style/largeShape</item>
	</style>

	<!--MISC. STYLE-->

	<style name="appSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
		<item name="thumbTint">@color/surface</item>
		<item name="trackDecorationTint">@color/switch_track_deco_color</item>
		<item name="trackTint">@color/switch_track_deco_color</item>
		<item name="android:textAppearance">@style/TitleMedium</item>
		<item name="android:textColor">@color/onSurface</item>
	</style>

	<style name="noInternetStyle">
		<!--		<item name="icon">@drawable/no_result</item>-->
		<!--		<item name="title_text">@string/oops</item>-->
		<!--		<item name="desc_text">@string/no_internet</item>-->
