<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="LoaderView">
        <attr name="loaderStyle" format="reference" />
        <attr name="loaderColor" format="color" />
        <attr name="showBack" format="boolean" />
    </declare-styleable>

    <declare-styleable name="NoDataView">
        <attr name="desc_text" format="string" />
        <attr name="title_text" format="string" />
        <attr name="icon" format="reference" />
        <attr name="iconVisible" format="boolean" />
        <attr name="btn_title" format="string" />
        <attr name="show_button" format="boolean" />
    </declare-styleable>

    <declare-styleable name="Header">
        <attr name="secondaryIconDrawable" format="reference" />
        <attr name="primaryIconDrawable" format="reference" />
        <attr name="backIconDrawable" format="reference" />
        <attr name="showSecondaryIcon" format="boolean" />
        <attr name="showPrimaryIcon" format="boolean" />
        <attr name="showBackButton" format="boolean" />
        <attr name="showAppTitle" format="boolean" />
        <attr name="headerTitle" format="string" />
        <attr name="headerMode" format="enum">
            <enum name="BACK_BUTTON_TITLE_ACTION" value="0" />
            <enum name="APP_TEXT_ACTION" value="1" />
            <enum name="APP_TEXT_BACK_ACTION" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="Heading">
        <attr name="title" format="string" />
        <attr name="style" format="reference" />
    </declare-styleable>

	<attr name="entryChipStyleNew" format="reference" />

</resources>