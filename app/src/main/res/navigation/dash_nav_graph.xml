<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dash_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="io.bidswipe.app.ui.dashboard.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/goToSearchShowFragment"
            app:destination="@id/searchShowFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

         <action
            android:id="@+id/goToExploreFragment"
            app:destination="@id/exploreFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />


    </fragment>
    <fragment
        android:id="@+id/exploreFragment"
        android:name="io.bidswipe.app.ui.dashboard.ExploreFragment"
        android:label="fragment_explore"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/goTopExploreType"
            app:destination="@id/exploreTypeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <!-- Basecamp #9960348333 (Trey 2026-06-04): the Explore search bar must
             behave the SAME as the Home search bar (unified shows/products/users
             search), not the category-grid filter. Route to the same
             SearchShowFragment that Home uses. -->
        <action
            android:id="@+id/goToSearchFromExplore"
            app:destination="@id/searchShowFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/activityFragment"
        android:name="io.bidswipe.app.ui.dashboard.ActivityFragment"
        android:label="fragment_activity"
        tools:layout="@layout/fragment_activity" />
    <fragment
        android:id="@+id/accountFragment"
        android:name="io.bidswipe.app.ui.dashboard.AccountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account" >
        <action
            android:id="@+id/toClipsFragment"
            app:destination="@id/clipsFragment" />
    </fragment>
    <fragment
        android:id="@+id/exploreTypeFragment"
        android:name="io.bidswipe.app.ui.dashboard.ExploreTypeFragment"
        android:label="fragment_explore_type"
        tools:layout="@layout/fragment_explore_type" />

    <fragment
        android:id="@+id/searchShowFragment"
        android:name="io.bidswipe.app.ui.dashboard.SearchShowFragment"
        android:label="fragment_search_show"
        tools:layout="@layout/fragment_search_show" />
    <fragment
        android:id="@+id/clipsFragment"
        android:name="io.bidswipe.app.ui.sellerProfile.ClipsFragment"
        android:label="fragment_clips"
        tools:layout="@layout/fragment_clips" />

</navigation>