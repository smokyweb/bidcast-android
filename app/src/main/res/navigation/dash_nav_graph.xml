<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dash_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="io.bidswipe.app.ui.dashboard.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/goToSearchShowFragment"
            app:destination="@id/searchShowFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/exploreFragment"
        android:name="io.bidswipe.app.ui.dashboard.ExploreFragment"
        android:label="fragment_explore"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/goTopExploreType"
            app:destination="@id/exploreTypeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/activityFragment"
        android:name="io.bidswipe.app.ui.dashboard.ActivityFragment"
        android:label="fragment_activity"
        tools:layout="@layout/fragment_activity" />
    <fragment
        android:id="@+id/accountFragment"
        android:name="io.bidswipe.app.ui.dashboard.AccountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account"/>
    <fragment
        android:id="@+id/exploreTypeFragment"
        android:name="io.bidswipe.app.ui.dashboard.ExploreTypeFragment"
        android:label="fragment_explore_type"
        tools:layout="@layout/fragment_explore_type" />

    <fragment
        android:id="@+id/searchShowFragment"
        android:name="io.bidswipe.app.ui.dashboard.SearchShowFragment"
        android:label="fragment_search_show"
        tools:layout="@layout/fragment_search_show" />

</navigation>