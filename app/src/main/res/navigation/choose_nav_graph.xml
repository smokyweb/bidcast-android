<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="io.bidswipe.app.ui.dashboard.interest.CategoryFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_category">

        <action
            android:id="@+id/gotoSubcategory"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="io.bidswipe.app.ui.dashboard.interest.SubCategoryFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_subcategory">

        <action
            android:id="@+id/toSubcategory"
            app:destination="@id/SecondFragment"/>
    </fragment>
</navigation>