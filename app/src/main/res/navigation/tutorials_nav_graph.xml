<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tutorials_nav_graph"
    app:startDestination="@id/getStartedFragment">

    <fragment
        android:id="@+id/getStartedFragment"
        android:name="io.bidswipe.app.ui.dashboard.tutorials.GetStartedFragment"
        android:label="fragment_get_started"
        tools:layout="@layout/fragment_get_started" >
        <action
            android:id="@+id/goToPlayerFragment"
            app:destination="@id/playerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:id="@+id/playerFragment"
        android:name="io.bidswipe.app.ui.dashboard.tutorials.PlayerFragment"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player" >
        <action
            android:id="@+id/goToSellFragment"
            app:destination="@id/howToSellFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:id="@+id/howToSellFragment"
        android:name="io.bidswipe.app.ui.dashboard.tutorials.HowToSellFragment"
        android:label="fragment_how_to_sell"
        tools:layout="@layout/fragment_how_to_sell" >
        <action
            android:id="@+id/goToPrepareYourShowFragment"
            app:destination="@id/prepareYourShowFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:id="@+id/prepareYourShowFragment"
        android:name="io.bidswipe.app.ui.dashboard.tutorials.PrepareYourShowFragment"
        android:label="fragment_prepare_your_show"
        tools:layout="@layout/fragment_prepare_your_show" >
        <action
            android:id="@+id/goToShowTipsFragment"
            app:destination="@id/showTipsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:id="@+id/showTipsFragment"
        android:name="io.bidswipe.app.ui.dashboard.tutorials.ShowTipsFragment"
        android:label="fragment_show_tips"
        tools:layout="@layout/fragment_show_tips" >
        <action
            android:id="@+id/goToLiveRehearsalFragment"
            app:destination="@id/liveRehearsalFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:id="@+id/liveRehearsalFragment"
        android:name="io.bidswipe.app.ui.dashboard.tutorials.LiveRehearsalFragment"
        android:label="fragment_live_rehearsal"
        tools:layout="@layout/fragment_live_rehearsal" />
</navigation>