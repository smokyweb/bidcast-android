<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/schedule_show_graph"
    app:startDestination="@id/showTitleFragment">

    <fragment
        android:id="@+id/showTitleFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.ShowTitleFragment"
        android:label="fragment_show_title"
        tools:layout="@layout/fragment_show_title">
        <action
            android:id="@+id/goToSelectShowTimeFragment"
            app:destination="@id/selectShowTimeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/goToSelectCategoryFragment"
            app:destination="@id/selectCategoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/selectShowTimeFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.SelectShowTimeFragment"
        android:label="fragment_select_show_time"
        tools:layout="@layout/fragment_select_show_time">
        <action
            android:id="@+id/ShowTimeFragment_to_selectCategoryFragment"
            app:destination="@id/selectCategoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/selectCategoryFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.SelectCategoryFragment"
        android:label="fragment_select_category"
        tools:layout="@layout/fragment_select_category">
        <action
            android:id="@+id/goToSelectThumbnailFragment"
            app:destination="@id/selectThumbnailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/selectThumbnailFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.SelectThumbnailFragment"
        android:label="fragment_select_thumbnail"
        tools:layout="@layout/fragment_select_thumbnail">
        <action
            android:id="@+id/goToProductTipsFragment"
            app:destination="@id/productTipsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/selectThumbnail_to_createProductFragment"
            app:destination="@id/createProductFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_selectThumbnailFragment_to_addProductFragment"
            app:destination="@id/addProductFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/productTipsFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.ProductTipsFragment"
        android:label="fragment_product_tips"
        tools:layout="@layout/fragment_product_tips">

        <action
            android:id="@+id/goToCreateProductFragment"
            app:destination="@id/createProductFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/createProductFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.CreateProductFragment"
        android:label="fragment_create_product"
        tools:layout="@layout/fragment_list_a_product">
        <action
            android:id="@+id/goToChooseSalesFormatFragment"
            app:destination="@id/chooseSalesFormatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/createProductAddProductFragment"
            app:destination="@id/addProductFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/chooseSalesFormatFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.ChooseSalesFormatFragment"
        android:label="fragment_choose_sales_format"
        tools:layout="@layout/fragment_choose_sales_format">
        <action
            android:id="@+id/goToProductWeightFragment"
            app:destination="@id/productWeightFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/productWeightFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.ProductWeightFragment"
        android:label="fragment_product_weight"
        tools:layout="@layout/fragment_product_weight">
        <action
            android:id="@+id/goToAddProductFragment"
            app:destination="@id/addProductFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/addProductFragment"
        android:name="io.bidswipe.app.ui.scheduleShow.AddProductFragment"
        android:label="fragment_add_product"
        tools:layout="@layout/fragment_add_product">

        <action
            android:id="@+id/addProductFragment_to_createProductFragment"
            app:destination="@id/createProductFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/createProductFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>