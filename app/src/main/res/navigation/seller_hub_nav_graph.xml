<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seller_hub_nav_graph"
    app:startDestination="@id/inventoryFragment">

    <fragment
        android:id="@+id/inventoryFragment"
        android:name="io.bidswipe.app.ui.sellerHub.InventoryFragment"
        android:label="fragment_inventory"
        tools:layout="@layout/fragment_inventory" />
    <fragment
        android:id="@+id/myOrdersFragment"
        android:name="io.bidswipe.app.ui.sellerHub.MyOrdersFragment"
        android:label="fragment_my_orders"
        tools:layout="@layout/fragment_my_orders" >

        <action
            android:id="@+id/toOrderStatus"
            app:destination="@id/orderStatusFragment" />
    </fragment>
    <fragment
        android:id="@+id/sellerOffersFragment"
        android:name="io.bidswipe.app.ui.sellerHub.SellerOffersFragment"
        android:label="fragment_seller_offers"
        tools:layout="@layout/fragment_seller_offers" />
    <fragment
        android:id="@+id/walletFragment"
        android:name="io.bidswipe.app.ui.sellerHub.WalletFragment"
        android:label="fragment_wallet"
        tools:layout="@layout/fragment_wallet">
        <action
            android:id="@+id/goToPayoutFragment"
            app:destination="@id/payoutFragment" />
    </fragment>


    <fragment
        android:id="@+id/showsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.ShowsFragment"
        android:label="fragment_shows"
        tools:layout="@layout/fragment_shows" >
        <action
            android:id="@+id/toShowDetails"
            app:destination="@id/showDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/shippingFragment"
        android:name="io.bidswipe.app.ui.sellerHub.shipping.ShippingFragment"
        android:label="fragment_shipping"
        tools:layout="@layout/fragment_shipping" >
        <action
            android:id="@+id/toFreePickup"
            app:destination="@id/freePIckupFragment" />
        <action
            android:id="@+id/toDomesticShipments"
            app:destination="@id/domesticShipmentsFragment" />
        <action
            android:id="@+id/toShippingProfiles"
            app:destination="@id/shippingProfilesFragment" />
        <action
            android:id="@+id/toShippingCost"
            app:destination="@id/shippingCostsFragment" />
    </fragment>
    <fragment
        android:id="@+id/tipsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.TipsFragment"
        android:label="fragment_tips"
        tools:layout="@layout/fragment_tips" />
    <fragment
        android:id="@+id/affiliateProgramFragment"
        android:name="io.bidswipe.app.ui.sellerHub.AffiliateProgramFragment"
        android:label="fragment_affiliate_program"
        tools:layout="@layout/fragment_affiliate_program" />
    <fragment
        android:id="@+id/howToSellFragment2"
        android:name="io.bidswipe.app.ui.tutorials.HowToSellFragment"
        android:label="fragment_how_to_sell"
        tools:layout="@layout/fragment_how_to_sell" />
    <fragment
        android:id="@+id/sellerStatusFragment"
        android:name="io.bidswipe.app.ui.sellerHub.SellerStatusFragment"
        android:label="fragment_seller_status"
        tools:layout="@layout/fragment_seller_status" />
    <fragment
        android:id="@+id/premierShopFragment"
        android:name="io.bidswipe.app.ui.sellerHub.PremierShopFragment"
        android:label="fragment_premier_shop"
        tools:layout="@layout/fragment_premier_shop" />
    <fragment
        android:id="@+id/promoteToolsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.PromoteToolsFragment"
        android:label="fragment_promote_tools"
        tools:layout="@layout/fragment_promote_tools" />
    <fragment
        android:id="@+id/analyticsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.AnalyticsFragment"
        android:label="fragment_analytics"
        tools:layout="@layout/fragment_analytics" />
    <fragment
        android:id="@+id/sellerVerificationFragment"
        android:name="io.bidswipe.app.ui.sellerHub.SellerVerificationFragment"
        android:label="fragment_seller_verification"
        tools:layout="@layout/activity_seller_verification" />
    <fragment
        android:id="@+id/KYCFragment"
        android:name="io.bidswipe.app.ui.sellerHub.KYCFragment"
        android:label="fragment_k_y_c"
        tools:layout="@layout/fragment_k_y_c" />
    <fragment
        android:id="@+id/payoutFragment"
        android:name="io.bidswipe.app.ui.sellerHub.PayoutFragment"
        android:label="fragment_payout"
        tools:layout="@layout/fragment_payout" />
    <fragment
        android:id="@+id/orderStatusFragment"
        android:name="io.bidswipe.app.ui.product.OrderStatusFragment"
        android:label="fragment_order_status"
        tools:layout="@layout/fragment_order_status" />
    <fragment
        android:id="@+id/showDetailsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.ShowDetailsFragment"
        android:label="fragment_show_details"
        tools:layout="@layout/fragment_show_details" >
        <action
            android:id="@+id/showDetailsVideoReceiptPlayerFragment2"
            app:destination="@id/videoReceiptPlayerFragment2" />
    </fragment>
    <fragment
        android:id="@+id/freePIckupFragment"
        android:name="io.bidswipe.app.ui.sellerHub.shipping.FreePickupFragment"
        android:label="FreePIckupFragment" />
    <fragment
        android:id="@+id/domesticShipmentsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.shipping.DomesticShipmentsFragment"
        android:label="fragment_domestic_shipments"
        tools:layout="@layout/fragment_domestic_shipments" />
    <fragment
        android:id="@+id/createShippingProfileFragment"
        android:name="io.bidswipe.app.ui.sellerHub.shipping.CreateShippingProfileFragment"
        android:label="fragment_create_shipping_profile"
        tools:layout="@layout/fragment_create_shipping_profile" />
    <fragment
        android:id="@+id/shippingProfilesFragment"
        android:name="io.bidswipe.app.ui.sellerHub.shipping.ShippingProfilesFragment"
        android:label="fragment_shipping_profiles"
        tools:layout="@layout/fragment_shipping_profiles" >
        <action
            android:id="@+id/toCreateShippingProfile"
            app:destination="@id/createShippingProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/shippingCostsFragment"
        android:name="io.bidswipe.app.ui.sellerHub.shipping.ShippingCostsFragment"
        android:label="fragment_shipping_costs"
        tools:layout="@layout/fragment_shipping_costs" />
    <fragment
        android:id="@+id/videoReceiptPlayerFragment2"
        android:name="io.bidswipe.app.ui.product.VideoReceiptPlayerFragment"
        android:label="fragment_video_receipt_player"
        tools:layout="@layout/fragment_video_receipt_player" />

</navigation>