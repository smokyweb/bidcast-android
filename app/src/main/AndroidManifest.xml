<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.bidswipe.app">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:allowClearUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bidswipe"
        tools:targetApi="31">
        <activity
            android:name=".ui.dashboard.sellerProfile.SellerProfileActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.product.ProductDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.sellerHub.SellerHubActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.more.MoreActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.LanguageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.scheduleShow.ScheduleShowActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.tutorials.TutorialsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.sell.ListAProductActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.DashActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false" />
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Bidswipe.ActionBar"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity" />
    </application>

</manifest>