<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissions required by the SDK -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" /> <!-- Permissions required by the App -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />
    <uses-feature android:name="android.hardware.camera" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"
        tools:ignore="SelectedPhotoAccess" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:allowClearUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bidswipe"
        tools:targetApi="31">
        <activity
            android:name="io.bidswipe.app.ui.scheduleShow.ChooseModeActivity"
            android:exported="false"></activity>
        <activity
            android:name="io.bidswipe.app.ui.scheduleShow.DolbyStreamActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.scheduleShow.DolbySubscribeActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.interest.ChooseInterestActivity"
            android:exported="false"
            android:theme="@style/Theme.Bidswipe" />
        <activity
            android:name=".ui.dashboard.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.RateSellerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.UpdateAccountActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.more.NotificationActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.watchStream.ViewLiveShowActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.bidswipe.app.ui.scheduleShow.LiveShowActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.bidswipe.app.ui.scheduleShow.LiveShowSocketActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:resizeableActivity="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.dashboard.AddPaymentCardActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.sellerProfile.SellerProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.bidswipe.app.ui.product.ProductDetailsActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.sellerHub.SellerHubActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.more.MoreActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.LanguageActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.scheduleShow.ScheduleShowActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.tutorials.TutorialsActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.sell.ListAProductActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.DashActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="backend.bidcast.betaplanets.com" />
                <data android:pathPrefix="/live-show" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.SpoofSocketActivity"
            android:exported="true"
            android:label="Socket Test Activity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="bidcast" />
                <data android:host="socket-test" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/RemoveSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="backend.bidcast.betaplanets.com" />
                <data android:pathPattern="/referral-code" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.bidswipe.app.ui.more.TrustedBuyerActivity"
            android:exported="false" />
        <activity
            android:name="io.bidswipe.app.ui.sellerHub.SellerVerificationActivity"
            android:exported="false" />
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.Bidswipe.ActionBar"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity" />

        <service
            android:name=".messaging.MyFirebaseMessagingService"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>